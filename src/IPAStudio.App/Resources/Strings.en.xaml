    <!-- Install errors -->
    <sys:String x:Key="L.Install.Error.CoordinatedInstall">The device is still holding an unfinished App Store download of this app. Delete the app's icon from the home screen — including a dimmed or half-installed one — then try again.</sys:String>
    <sys:String x:Key="L.Install.Error.NoSpace">Not enough free space on the device.</sys:String>
    <sys:String x:Key="L.Install.Error.ExtractionFailed">The device could not unpack the app. This is nearly always a space problem: installing needs room for two to three times the app's size, so it fails even while the phone still shows some space free. Free up space in Settings — General — iPhone Storage, then try again.</sys:String>
