<Window x:Class="IPAStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IPAStudio.App.ViewModels"
        xmlns:views="clr-namespace:IPAStudio.App.Views"
        xmlns:conv="clr-namespace:IPAStudio.App.Converters"
        x:Name="Root"
        Width="1120" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:SubtractConverter x:Key="Subtract" />
        <conv:PercentToArcConverter x:Key="PercentToArc" />
        <conv:SectorArcConverter x:Key="SectorArc" />
        <DataTemplate DataType="{x:Type vm:SetupViewModel}">
            <views:SetupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
            <views:DevicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppPickerViewModel}">
            <views:AppPickerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QueueViewModel}">
            <views:QueueView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceInfoViewModel}">
            <views:DeviceInfoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PhotosViewModel}">
            <views:PhotosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ICloudViewModel}">
            <views:ICloudView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OnDeviceViewModel}">
            <views:OnDeviceView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DirectDownloadViewModel}">
            <views:DirectDownloadView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IpaCatalogsViewModel}">
            <views:IpaCatalogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MediaExportViewModel}">
            <views:MediaExportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FirmwareViewModel}">
            <views:FirmwareView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Page host; code-behind plays a fade+slide transition on navigation. -->
        <ContentControl x:Name="PageHost" Content="{Binding CurrentViewModel}">
            <!-- The gear and the operations circle are both drawn on top of the page, and pages
                 reserve 56px on their right so their own header buttons clear the gear (which
                 ends 42px in). The circle sits beside the gear, spanning 50-84px from the right
                 edge, so 28px of it reached past that reserve and sat on those page headers.

                 Widening the reserve on all eight pages would leave the space empty whenever no
                 operation is running, so the page is inset only while the circle is on screen:
                 28px of overlap plus an 8px gap. Each page's own 56px still clears the gear, so
                 nothing changes for anyone who never starts a background operation. -->
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Margin" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Operations.HasOperations}" Value="True">
                            <Setter Property="Margin" Value="0,0,36,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <ContentControl.RenderTransform>
                <TranslateTransform x:Name="PageTranslate" />
            </ContentControl.RenderTransform>
        </ContentControl>

        <!-- ===== Decorative overlay (non-interactive) ===== -->

        <!-- Animated developer credit — now a clickable button that opens a
             contact popup. The shimmer animation is preserved on the inner TextBlock. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,6" Panel.ZIndex="5">

            <!-- Clickable credit button (transparent, no chrome) -->
            <Button x:Name="CreditButton" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Padding="4,2" Click="CreditButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Button.Template>

                <TextBlock x:Name="CreditText" Text="{DynamicResource L.Credit}"
                           FontFamily="{StaticResource Font.Body}" FontSize="10"
                           FontWeight="SemiBold" Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="CreditSlide" Y="8" />
                    </TextBlock.RenderTransform>
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                            <GradientStop x:Name="Shimmer1" Color="{StaticResource Color.TextMuted}" Offset="-0.4" />
                            <GradientStop x:Name="Shimmer2" Color="{StaticResource Color.Accent}" Offset="-0.2" />
                            <GradientStop x:Name="Shimmer3" Color="{StaticResource Color.TextMuted}" Offset="0.0" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CreditText"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.85" Duration="0:0:0.9" />
                                    <DoubleAnimation Storyboard.TargetName="CreditSlide"
                                                     Storyboard.TargetProperty="Y"
                                                     To="0" Duration="0:0:0.9">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Shimmer1"
                                                     Storyboard.TargetProperty="Offset"
                                                     From="-0.4" To="1.0" Duration="0:0:2.6"
                                                     BeginTime="0:0:1.0" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="Shimmer2"
                                                     Storyboard.TargetProperty="Offset"
                                                     From="-0.2" To="1.2" Duration="0:0:2.6"
                                                     BeginTime="0:0:1.0" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="Shimmer3"
                                                     Storyboard.TargetProperty="Offset"
                                                     From="0.0" To="1.4" Duration="0:0:2.6"
                                                     BeginTime="0:0:1.0" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </Button>

            <!-- Contact popup — opens above the credit line on click -->
            <Popup x:Name="ContactPopup" PlacementTarget="{Binding ElementName=CreditButton}"
                   Placement="Top" VerticalOffset="-6"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{StaticResource Brush.Surface}" CornerRadius="12"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        Padding="16,14" Margin="8,0,8,4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.45" Color="#000000" />
                    </Border.Effect>
                    <StackPanel MinWidth="220">
                        <TextBlock Text="{DynamicResource L.Contact.Title}"
                                   FontFamily="{StaticResource Font.Body}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"
                                   Margin="0,0,0,10" />

                        <!-- Email -->
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalContentAlignment="Left" Padding="0,0,0,8"
                                Click="ContactEmail_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource Brush.Accent}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel>
                                    <TextBlock x:Name="EmailCaption"
                                               Text="{DynamicResource L.Contact.Email}"
                                               FontFamily="{StaticResource Font.Body}" FontSize="11"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                    <TextBlock Text="leq77751@gmail.com"
                                               FontFamily="{StaticResource Font.Body}" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Accent}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,2,0,8" />

                        <!-- Telegram -->
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalContentAlignment="Left" Padding="0"
                                Click="ContactTelegram_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource Brush.Accent}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.Contact.Telegram}"
                                               FontFamily="{StaticResource Font.Body}" FontSize="11"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                    <TextBlock Text="@alfredyester"
                                               FontFamily="{StaticResource Font.Body}" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Accent}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <!-- ===== Update/menu button + flyout ===== -->
        <!-- Positioned at top-right with enough top margin so it clears the
             per-page header row (DevicesView, etc.) — never overlaps their buttons. -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
              DataContext="{Binding Updater}"
              Panel.ZIndex="10">
            <Button x:Name="UpdateButton" Width="34" Height="34" Padding="0"
                    Cursor="Hand" ToolTip="{DynamicResource L.Menu.Title}"
                    Command="{Binding ToggleCommand}"
                    PreviewMouseLeftButtonDown="UpdateButton_PreviewMouseDown"
                    Background="Transparent" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="17"
                                Background="Transparent" BorderThickness="1"
                                BorderBrush="Transparent"
                                RenderTransformOrigin="0.5,0.5">
                            <Grid>
                                <!-- Settings (gear) glyph -->
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="{StaticResource Brush.TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <!-- Accent dot when an update is available -->
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Accent}"
                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,3,3,0"
                                         Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                                <Setter TargetName="bg" Property="RenderTransform" Value="{StaticResource Transform.Scale.IconHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.Surface}" />
                                <Setter TargetName="bg" Property="RenderTransform" Value="{StaticResource Transform.Scale.IconPress}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Popup x:Name="UpdaterPopup" IsOpen="{Binding IsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=UpdateButton}"
                   Placement="Bottom" HorizontalOffset="-244" VerticalOffset="6"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
                <!-- Wrapper grid with fixed width isolates WPF PopupRoot window layout
                     from inner RenderTransform/Storyboard scale shifts on Loaded. -->
                <Grid Width="286">
                    <Border Background="{StaticResource Brush.Surface}" CornerRadius="12"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            Width="270" Padding="16" Margin="8"
                            RenderTransformOrigin="0.94, 0.0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                            <TranslateTransform X="0" Y="0" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.20">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                     From="0.25" To="1.0" Duration="0:0:0.24">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.25" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                     From="0.25" To="1.0" Duration="0:0:0.24">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.25" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                     From="-12" To="0" Duration="0:0:0.24">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                    </Border.Effect>
                    <!-- Capped to the window's height and scrolled past that point. This menu is
                         taller than a short window, and because a popup is its own top-level
                         window nothing clipped it: the lower half simply hung off the bottom
                         edge, out of reach. The reserve covers the gear button's own offset from
                         the top plus this border's margin and padding. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="{Binding ActualHeight, ElementName=Root,
                                              Converter={StaticResource Subtract}, ConverterParameter=165}">
                    <StackPanel>
                        <!-- Menu header -->
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource L.Menu.Title}" Style="{StaticResource Text.Body}"
                                       FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Caption}">
                                <Run Text="v" /><Run Text="{Binding VersionText, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>

                        <!-- Settings page.
                             First item, and present at all: the gear carries the settings
                             glyph, so this flyout is where anyone hunting for a setting
                             looks - yet every setting except the theme lives on a separate
                             page that had no way in whatsoever. Its navigation command
                             existed but was bound to nothing, so the page was unreachable
                             and everything on it impossible to find. -->
                        <Button Content="{DynamicResource L.Settings.Title}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Stretch" Click="OpenSettings_Click" />

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource Brush.Border}"
                                Margin="0,12,0,12" />

                        <!-- Updates section -->
                        <TextBlock Text="{DynamicResource L.Update.Title}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,6" />

                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />

                        <ProgressBar Style="{StaticResource Progress.Slim}" Minimum="0" Maximum="1"
                                     Value="{Binding Progress}" Margin="0,0,0,10"
                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />

                        <Button Content="{DynamicResource L.Update.Check}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Stretch" Command="{Binding CheckCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                Margin="0,0,0,8" />
                        <Button Content="{DynamicResource L.Update.Download}" Style="{StaticResource Button.Primary}"
                                HorizontalAlignment="Stretch" Command="{Binding DownloadCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,8" />
                        <Button Content="{DynamicResource L.Update.Install}" Style="{StaticResource Button.Primary}"
                                HorizontalAlignment="Stretch" Command="{Binding InstallCommand}"
                                Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{DynamicResource L.WhatsNew.MenuTitle}" Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Stretch" Click="OpenWhatsNew_Click" Margin="0,6,0,0" />

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource Brush.Border}"
                                Margin="0,12,0,12" />

                        <!-- Tools section. Lives here rather than on DevicesView because
                             downloading an IPA by Bundle ID needs no connected device. -->
                        <TextBlock Text="{DynamicResource L.Menu.Tools}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,6" />
                        <Button Content="{DynamicResource L.Direct.Title}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Stretch" Click="OpenDirectDownload_Click"
                                Margin="0,0,0,8" />
                        <Button Content="{DynamicResource L.ICloud.Title}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Stretch" Click="OpenICloud_Click"
                                Margin="0,0,0,8" />
                        <Button Content="{DynamicResource L.MediaExport.MenuTitle}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Stretch" Click="OpenMediaExport_Click" Margin="0,0,0,8" />
                        <Button Content="{DynamicResource L.Firmware.Title}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Stretch" Click="OpenFirmware_Click" />

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource Brush.Border}"
                                Margin="0,12,0,12" />

                        <!-- Diagnostics section -->
                        <TextBlock Text="{DynamicResource L.Menu.Diagnostics}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,6" />
                        <Button Content="{DynamicResource L.Menu.Logs}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Stretch" Command="{Binding ShowLogsCommand}" />

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource Brush.Border}"
                                Margin="0,12,0,12" />

                        <!-- Appearance section -->
                        <TextBlock Text="{DynamicResource L.Settings.Theme}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton Content="{DynamicResource L.Settings.Theme.Dark}" GroupName="MenuTheme"
                                         Foreground="{StaticResource Brush.Text}"
                                         IsChecked="{Binding ThemeIsDark}" Margin="0,0,20,0" />
                            <RadioButton Content="{DynamicResource L.Settings.Theme.Light}" GroupName="MenuTheme"
                                         Foreground="{StaticResource Brush.Text}"
                                         IsChecked="{Binding ThemeIsLight}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource L.Settings.Theme.RestartHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource Brush.Border}"
                                Margin="0,12,0,12" />

                        <!-- Maintenance section -->
                        <TextBlock Text="{DynamicResource L.Menu.Maintenance}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding CacheStatusText}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding CacheStatusText, Converter={StaticResource NullToCollapsed}}" />

                        <!-- Breakdown from the last check: what is taking the space. -->
                        <ItemsControl ItemsSource="{Binding CacheGroups}" Margin="0,0,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4" ToolTip="{Binding Path}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                                   Style="{StaticResource Text.Caption}"
                                                   FontWeight="SemiBold" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding CacheTotalText}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Margin="0,0,0,8"
                                   Visibility="{Binding CacheTotalText, Converter={StaticResource NullToCollapsed}}" />

                        <!-- Indeterminate while measuring (a scan has no total), then a
                             real bar driven by bytes deleted. -->
                        <ProgressBar Style="{StaticResource Progress.Slim}" Minimum="0" Maximum="1"
                                     Value="{Binding CacheProgress}"
                                     IsIndeterminate="{Binding IsScanningCache}"
                                     Margin="0,0,0,8"
                                     Visibility="{Binding IsCacheBusy, Converter={StaticResource BoolToVis}}" />

                        <Button Content="{DynamicResource L.Menu.CheckCache}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Stretch" Command="{Binding CheckCacheCommand}"
                                IsEnabled="{Binding IsCacheBusy, Converter={StaticResource InverseBool}}"
                                Margin="0,0,0,8" />
                        <Button Content="{DynamicResource L.Menu.ClearCache}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Stretch" Command="{Binding ClearCacheCommand}"
                                IsEnabled="{Binding IsCacheBusy, Converter={StaticResource InverseBool}}" />

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource Brush.Border}"
                                Margin="0,12,0,12" />

                        <!-- Rollback. Password-gated: locked by default, so it never shows up
                             as a stray button next to "Check for updates". -->
                        <TextBlock Text="{DynamicResource L.Rollback.Title}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,6" />

                        <StackPanel Visibility="{Binding RollbackUnlocked, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <TextBlock Text="{DynamicResource L.Rollback.PasswordHint}"
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <PasswordBox x:Name="RollbackPasswordBox" Margin="0,0,0,8"
                                         PasswordChanged="RollbackPasswordBox_PasswordChanged" />
                            <TextBlock Text="{Binding RollbackPasswordError}" Style="{StaticResource Text.Caption}"
                                       Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding RollbackPasswordError, Converter={StaticResource NullToCollapsed}}" />
                            <Button Content="{DynamicResource L.Rollback.Unlock}" Style="{StaticResource Button.Secondary}"
                                    HorizontalAlignment="Stretch" Command="{Binding UnlockRollbackCommand}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding RollbackUnlocked, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding RollbackStatusText}" Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding RollbackStatusText, Converter={StaticResource NullToCollapsed}}" />

                            <ProgressBar Style="{StaticResource Progress.Slim}" Minimum="0" Maximum="1"
                                         IsIndeterminate="{Binding IsLoadingReleases}"
                                         Value="{Binding Progress}" Margin="0,0,0,8"
                                         Visibility="{Binding IsRollingBack, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{DynamicResource L.Rollback.PickVersion}"
                                       Style="{StaticResource Text.Caption}" Margin="0,0,0,6"
                                       Visibility="{Binding HasRollbackReleases, Converter={StaticResource BoolToVis}}" />
                            <ComboBox ItemsSource="{Binding RollbackReleases}"
                                      SelectedItem="{Binding SelectedRollbackRelease}"
                                      DisplayMemberPath="DisplayVersion"
                                      Margin="0,0,0,8"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                      Visibility="{Binding HasRollbackReleases, Converter={StaticResource BoolToVis}}" />

                            <Button Content="{DynamicResource L.Rollback.Button}" Style="{StaticResource Button.Primary}"
                                    HorizontalAlignment="Stretch" Command="{Binding RollbackCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                    Margin="0,0,0,8"
                                    Visibility="{Binding HasRollbackReleases, Converter={StaticResource BoolToVis}}" />

                            <Button Content="{DynamicResource L.Rollback.Lock}" Style="{StaticResource Button.Secondary}"
                                    HorizontalAlignment="Stretch" Command="{Binding LockRollbackCommand}" />
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
                </Grid>
            </Popup>
        </Grid>

        <!-- ===== Background operations circle + list ===== -->
        <!-- Top-right, immediately left of the gear, so running work sits in the window's
             chrome rather than floating over page content at the bottom. Hidden entirely
             until there is an operation, keeping the window unchanged for anyone who leaves
             multitasking off. -->
        <!-- The pop animation scales this about its centre, so it needs clearance on every
             side: at 8px from the top the grown ring ran off the window edge and the circle
             came out visibly sliced. ClipToBounds stays off for the same reason. -->
        <Grid x:Name="OpsCorner" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,13,50,0" Panel.ZIndex="20" ClipToBounds="False"
              DataContext="{Binding Operations}"
              Visibility="{Binding HasOperations, Converter={StaticResource BoolToVis}}">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="OpsCircleScale" CenterX="17" CenterY="17" />
            </Grid.RenderTransform>

            <!-- 34px to match the gear button beside it. -->
            <Button x:Name="OpsButton" Width="34" Height="34" Padding="0" Cursor="Hand"
                    Command="{Binding ToggleListCommand}"
                    PreviewMouseLeftButtonDown="OpsButton_PreviewMouseDown"
                    ToolTip="{DynamicResource L.Ops.Title}"
                    Background="Transparent" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Track, then the arc that sweeps round it clockwise from the
                                 top as the work completes. -->
                            <Ellipse Stroke="{StaticResource Brush.Border}" StrokeThickness="3"
                                     Fill="{StaticResource Brush.Surface}" Margin="1.5" />

                            <!-- Single Circle Mode: Blue Arc (Apps / Queue) -->
                            <Path Stroke="{StaticResource Brush.Accent}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{Binding OverallProgress,
                                         Converter={StaticResource SectorArc},
                                         ConverterParameter='full,34'}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasRunning}" Value="True" />
                                                    <Condition Binding="{Binding IsSplitCircle}" Value="False" />
                                                    <Condition Binding="{Binding IsSingleFirmwareCircle}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <!-- Single Circle Mode: Purple Arc (Firmware) -->
                            <Path Stroke="{StaticResource Brush.Firmware}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{Binding FirmwareProgress,
                                         Converter={StaticResource SectorArc},
                                         ConverterParameter='full,34'}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasRunning}" Value="True" />
                                                    <Condition Binding="{Binding IsSingleFirmwareCircle}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <!-- Split Mode: Half 1 - Blue Arc (Apps, 12 to 6 o'clock) -->
                            <Path Stroke="{StaticResource Brush.Accent}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{Binding AppProgress,
                                         Converter={StaticResource SectorArc},
                                         ConverterParameter='half1,34'}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSplitCircle}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <!-- Split Mode: Half 2 - Purple Arc (Firmware, 6 to 12 o'clock) -->
                            <Path Stroke="{StaticResource Brush.Firmware}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{Binding FirmwareProgress,
                                         Converter={StaticResource SectorArc},
                                         ConverterParameter='half2,34'}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSplitCircle}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <!-- Number of operations still working; the glyph stands in once
                                 they have all finished so the circle never reads as "0". -->
                            <TextBlock Text="{Binding RunningCount}" Style="{StaticResource Text.Body}"
                                       FontWeight="SemiBold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasRunning, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Drops below the button centered directly beneath the circle. -->
            <Popup x:Name="OperationsPopup" IsOpen="{Binding IsListOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=OpsButton}"
                   Placement="Bottom" HorizontalOffset="-146" VerticalOffset="6"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
                <!-- Wrapper grid with fixed width isolates WPF PopupRoot window layout
                     from inner RenderTransform/Storyboard scale shifts on Loaded. -->
                <Grid Width="326">
                    <Border Background="{StaticResource Brush.Surface}" CornerRadius="12"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            Width="310" Padding="16" Margin="8"
                            RenderTransformOrigin="0.5, 0.0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                            <TranslateTransform X="0" Y="0" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.20">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                     From="0.20" To="1.0" Duration="0:0:0.24">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.25" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                     From="0.20" To="1.0" Duration="0:0:0.24">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.25" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                     From="-12" To="0" Duration="0:0:0.24">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Ops.Title}" Style="{StaticResource Text.Body}"
                                   FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />

                        <!-- Capped like the gear menu: several operations would otherwise run
                             off the bottom of a short window, and a popup is its own top-level
                             window so nothing would clip it. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="{Binding ActualHeight, ElementName=Root,
                                                  Converter={StaticResource Subtract}, ConverterParameter=160}">
                            <ItemsControl ItemsSource="{Binding Operations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Brush.SurfaceHover}" CornerRadius="8"
                                                Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:OperationKind.Firmware}">
                                                                        <Setter Property="Fill" Value="{StaticResource Brush.Firmware}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}"
                                                           TextTrimming="CharacterEllipsis" Margin="16,2,0,0" />

                                                <ProgressBar Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                                             Value="{Binding Progress, Mode=OneWay}"
                                                             Background="{StaticResource Brush.Border}"
                                                             BorderThickness="0"
                                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:OperationKind.Firmware}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Firmware}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>

                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Caption}"
                                                           Margin="0,6,0,0" />

                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="{DynamicResource L.Ops.Return}"
                                                            Style="{StaticResource Button.Secondary}"
                                                            HorizontalAlignment="Stretch"
                                                            Command="{Binding DataContext.ReturnCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Grid.Column="2"
                                                            Content="{DynamicResource L.Ops.Cancel}"
                                                            Style="{StaticResource Button.Secondary}"
                                                            HorizontalAlignment="Stretch"
                                                            Command="{Binding DataContext.CancelOneCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Content="{DynamicResource L.Ops.ClearFinished}"
                                Style="{StaticResource Button.Secondary}" HorizontalAlignment="Stretch"
                                Command="{Binding ClearFinishedOperationsCommand}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                </Grid>
            </Popup>
        </Grid>

        <!-- ===== What's New / Release Notes Modal Overlay ===== -->
        <Grid x:Name="WhatsNewOverlay" Panel.ZIndex="100"
              Visibility="Collapsed">

            <!-- Semi-transparent backdrop with click-to-dismiss -->
            <Border x:Name="WhatsNewBackdrop" Background="#90000000" Opacity="0"
                    MouseLeftButtonDown="WhatsNewBackdrop_MouseLeftButtonDown" />

            <!-- Centered Modal Host (Shadow + Content with crisp text and layout snapping) -->
            <Grid x:Name="WhatsNewCardHost"
                  Width="560" MaxHeight="640"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Opacity="0"
                  RenderTransformOrigin="0.5,0.5"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True"
                  TextOptions.TextFormattingMode="Display"
                  TextOptions.TextRenderingMode="ClearType"
                  TextOptions.TextHintingMode="Fixed">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="WhatsNewCardScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="WhatsNewCardTranslate" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- Dedicated Background Shadow Layer (Zero text content -> zero text rasterization blur) -->
                <Border CornerRadius="18"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="36" Direction="270"
                                          RenderingBias="Quality" ShadowDepth="8"
                                          Color="#000000" Opacity="0.45" />
                    </Border.Effect>
                </Border>

                <!-- Centered Modal Card (Direct ClearType text rendering, NO DropShadowEffect) -->
                <Border x:Name="WhatsNewCard"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="18"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">
                    <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Content / Highlights -->
                        <RowDefinition Height="*" />
                        <!-- Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Padding="24,20,20,16"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- App Icon / Sparkle Badge -->
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                                    Background="{DynamicResource Brush.AccentSoft}"
                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Title & Version Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource L.WhatsNew.Title}"
                                               FontSize="17" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Text}"
                                               VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource Brush.AccentSoft}"
                                            CornerRadius="6" Padding="7,2" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WhatsNew.CurrentNote.Version, StringFormat='v{0}'}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding WhatsNew.CurrentNote.Title}"
                                           Style="{StaticResource Text.Caption}"
                                           Margin="0,3,0,0" FontSize="12" />
                            </StackPanel>

                            <!-- Close Button ✕ -->
                            <Button Grid.Column="2" Style="{StaticResource Button.Ghost}"
                                    Width="32" Height="32" Padding="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding WhatsNew.CloseCommand}"
                                    ToolTip="{DynamicResource L.Common.Close}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Scrollable List of Changelog Highlights -->
                    <ScrollViewer Grid.Row="1" MaxHeight="420"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="24,16,24,16">
                        <ItemsControl ItemsSource="{Binding WhatsNew.CurrentNote.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" Padding="14,12"
                                            Background="{DynamicResource Brush.Background}"
                                            CornerRadius="10"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Badge + Title -->
                                            <DockPanel Grid.Row="0">
                                                <Border DockPanel.Dock="Left" CornerRadius="4" Padding="6,2"
                                                        Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#2510B981" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CategoryLabel}" Value="НОВОЕ">
                                                                    <Setter Property="Background" Value="#2510B981" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CategoryLabel}" Value="NEW">
                                                                    <Setter Property="Background" Value="#2510B981" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CategoryLabel}" Value="УЛУЧШЕНИЕ">
                                                                    <Setter Property="Background" Value="#256366F1" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CategoryLabel}" Value="IMPROVEMENT">
                                                                    <Setter Property="Background" Value="#256366F1" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CategoryLabel}" Value="ИСПРАВЛЕНИЕ">
                                                                    <Setter Property="Background" Value="#25F59E0B" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CategoryLabel}" Value="FIX">
                                                                    <Setter Property="Background" Value="#25F59E0B" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding CategoryLabel}"
                                                               FontSize="10" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#10B981" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CategoryLabel}" Value="НОВОЕ">
                                                                        <Setter Property="Foreground" Value="#10B981" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding CategoryLabel}" Value="NEW">
                                                                        <Setter Property="Foreground" Value="#10B981" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding CategoryLabel}" Value="УЛУЧШЕНИЕ">
                                                                        <Setter Property="Foreground" Value="#818CF8" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding CategoryLabel}" Value="IMPROVEMENT">
                                                                        <Setter Property="Foreground" Value="#818CF8" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding CategoryLabel}" Value="ИСПРАВЛЕНИЕ">
                                                                        <Setter Property="Foreground" Value="#F59E0B" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding CategoryLabel}" Value="FIX">
                                                                        <Setter Property="Foreground" Value="#F59E0B" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource Brush.Text}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>

                                            <!-- Description -->
                                            <TextBlock Grid.Row="1" Text="{Binding Description}"
                                                       Style="{StaticResource Text.Caption}"
                                                       FontSize="12" TextWrapping="Wrap"
                                                       Margin="0,6,0,0" LineHeight="18" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" Padding="24,14,24,18"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- GitHub Releases Link -->
                            <Button Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Style="{StaticResource Button.Ghost}" Padding="6,4"
                                    Command="{Binding WhatsNew.OpenReleasesUrlCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource L.WhatsNew.AllReleases}"
                                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Primary Dismiss Button -->
                            <Button Grid.Column="1"
                                    Content="{DynamicResource L.WhatsNew.Great}"
                                    Style="{StaticResource Button.Primary}"
                                    MinWidth="140" Height="36"
                                    Command="{Binding WhatsNew.CloseCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
