<Window x:Class="IPAStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IPAStudio.App.ViewModels"
        xmlns:views="clr-namespace:IPAStudio.App.Views"
        xmlns:conv="clr-namespace:IPAStudio.App.Converters"
        x:Name="Root"
        Width="1120" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:SubtractConverter x:Key="Subtract" />
        <conv:PercentToArcConverter x:Key="PercentToArc" />
        <DataTemplate DataType="{x:Type vm:SetupViewModel}">
            <views:SetupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
            <views:DevicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppPickerViewModel}">
            <views:AppPickerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QueueViewModel}">
            <views:QueueView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceInfoViewModel}">
            <views:DeviceInfoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PhotosViewModel}">
            <views:PhotosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ICloudViewModel}">
            <views:ICloudView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OnDeviceViewModel}">
            <views:OnDeviceView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DirectDownloadViewModel}">
            <views:DirectDownloadView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Page host; code-behind plays a fade+slide transition on navigation. -->
        <ContentControl x:Name="PageHost" Content="{Binding CurrentViewModel}">
            <ContentControl.RenderTransform>
                <TranslateTransform x:Name="PageTranslate" />
            </ContentControl.RenderTransform>
        </ContentControl>

        <!-- ===== Decorative overlay (non-interactive) ===== -->

        <!-- Animated developer credit — now a clickable button that opens a
             contact popup. The shimmer animation is preserved on the inner TextBlock. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,6" Panel.ZIndex="5">

            <!-- Clickable credit button (transparent, no chrome) -->
            <Button x:Name="CreditButton" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Padding="4,2" Click="CreditButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Button.Template>

                <TextBlock x:Name="CreditText" Text="{DynamicResource L.Credit}"
                           FontFamily="{StaticResource Font.Body}" FontSize="10"
                           FontWeight="SemiBold" Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="CreditSlide" Y="8" />
                    </TextBlock.RenderTransform>
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                            <GradientStop x:Name="Shimmer1" Color="{StaticResource Color.TextMuted}" Offset="-0.4" />
                            <GradientStop x:Name="Shimmer2" Color="{StaticResource Color.Accent}" Offset="-0.2" />
                            <GradientStop x:Name="Shimmer3" Color="{StaticResource Color.TextMuted}" Offset="0.0" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CreditText"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.85" Duration="0:0:0.9" />
                                    <DoubleAnimation Storyboard.TargetName="CreditSlide"
                                                     Storyboard.TargetProperty="Y"
                                                     To="0" Duration="0:0:0.9">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Shimmer1"
                                                     Storyboard.TargetProperty="Offset"
                                                     From="-0.4" To="1.0" Duration="0:0:2.6"
                                                     BeginTime="0:0:1.0" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="Shimmer2"
                                                     Storyboard.TargetProperty="Offset"
                                                     From="-0.2" To="1.2" Duration="0:0:2.6"
                                                     BeginTime="0:0:1.0" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="Shimmer3"
                                                     Storyboard.TargetProperty="Offset"
                                                     From="0.0" To="1.4" Duration="0:0:2.6"
                                                     BeginTime="0:0:1.0" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </Button>

            <!-- Contact popup — opens above the credit line on click -->
            <Popup x:Name="ContactPopup" PlacementTarget="{Binding ElementName=CreditButton}"
                   Placement="Top" VerticalOffset="-6"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{StaticResource Brush.Surface}" CornerRadius="12"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        Padding="16,14" Margin="8,0,8,4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.45" Color="#000000" />
                    </Border.Effect>
                    <StackPanel MinWidth="220">
                        <TextBlock Text="{DynamicResource L.Contact.Title}"
                                   FontFamily="{StaticResource Font.Body}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"
                                   Margin="0,0,0,10" />

                        <!-- Email -->
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalContentAlignment="Left" Padding="0,0,0,8"
                                Click="ContactEmail_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource Brush.Accent}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel>
                                    <TextBlock x:Name="EmailCaption"
                                               Text="{DynamicResource L.Contact.Email}"
                                               FontFamily="{StaticResource Font.Body}" FontSize="11"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                    <TextBlock Text="leq77751@gmail.com"
                                               FontFamily="{StaticResource Font.Body}" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Accent}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,2,0,8" />

                        <!-- Telegram -->
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalContentAlignment="Left" Padding="0"
                                Click="ContactTelegram_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource Brush.Accent}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.Contact.Telegram}"
                                               FontFamily="{StaticResource Font.Body}" FontSize="11"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                    <TextBlock Text="@alfredyester"
                                               FontFamily="{StaticResource Font.Body}" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Accent}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <!-- ===== Update/menu button + flyout ===== -->
        <!-- Positioned at top-right with enough top margin so it clears the
             per-page header row (DevicesView, etc.) — never overlaps their buttons. -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
              DataContext="{Binding Updater}"
              Panel.ZIndex="10">
            <Button x:Name="UpdateButton" Width="34" Height="34" Padding="0"
                    Cursor="Hand" ToolTip="{DynamicResource L.Menu.Title}"
                    Command="{Binding ToggleCommand}"
                    Background="Transparent" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="17"
                                Background="Transparent" BorderThickness="1"
                                BorderBrush="Transparent">
                            <Grid>
                                <!-- Settings (gear) glyph -->
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="{StaticResource Brush.TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <!-- Accent dot when an update is available -->
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Accent}"
                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,3,3,0"
                                         Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Popup IsOpen="{Binding IsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=UpdateButton}"
                   Placement="Bottom" HorizontalOffset="-234" VerticalOffset="6"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{StaticResource Brush.Surface}" CornerRadius="12"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        Width="270" Padding="16" Margin="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                    </Border.Effect>
                    <!-- Capped to the window's height and scrolled past that point. This menu is
                         taller than a short window, and because a popup is its own top-level
                         window nothing clipped it: the lower half simply hung off the bottom
                         edge, out of reach. The reserve covers the gear button's own offset from
                         the top plus this border's margin and padding. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="{Binding ActualHeight, ElementName=Root,
                                              Converter={StaticResource Subtract}, ConverterParameter=110}">
                    <StackPanel>
                        <!-- Menu header -->
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource L.Menu.Title}" Style="{StaticResource Text.Body}"
                                       FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Caption}">
                                <Run Text="v" /><Run Text="{Binding VersionText, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>

                        <!-- Settings page.
                             First item, and present at all: the gear carries the settings
                             glyph, so this flyout is where anyone hunting for a setting
                             looks - yet every setting except the theme lives on a separate
                             page that had no way in whatsoever. Its navigation command
                             existed but was bound to nothing, so the page was unreachable
                             and everything on it impossible to find. -->
                        <Button Content="{DynamicResource L.Settings.Title}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Stretch" Click="OpenSettings_Click" />

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource Brush.Border}"
                                Margin="0,12,0,12" />

                        <!-- Updates section -->
                        <TextBlock Text="{DynamicResource L.Update.Title}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,6" />

                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />

                        <ProgressBar Style="{StaticResource Progress.Slim}" Minimum="0" Maximum="1"
                                     Value="{Binding Progress}" Margin="0,0,0,10"
                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />

                        <Button Content="{DynamicResource L.Update.Check}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Stretch" Command="{Binding CheckCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                Margin="0,0,0,8" />
                        <Button Content="{DynamicResource L.Update.Download}" Style="{StaticResource Button.Primary}"
                                HorizontalAlignment="Stretch" Command="{Binding DownloadCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,8" />
                        <Button Content="{DynamicResource L.Update.Install}" Style="{StaticResource Button.Primary}"
                                HorizontalAlignment="Stretch" Command="{Binding InstallCommand}"
                                Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVis}}" />

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource Brush.Border}"
                                Margin="0,12,0,12" />

                        <!-- Tools section. Lives here rather than on DevicesView because
                             downloading an IPA by Bundle ID needs no connected device. -->
                        <TextBlock Text="{DynamicResource L.Menu.Tools}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,6" />
                        <Button Content="{DynamicResource L.Direct.Title}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Stretch" Click="OpenDirectDownload_Click"
                                Margin="0,0,0,8" />
                        <Button Content="{DynamicResource L.ICloud.Title}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Stretch" Click="OpenICloud_Click" />

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource Brush.Border}"
                                Margin="0,12,0,12" />

                        <!-- Diagnostics section -->
                        <TextBlock Text="{DynamicResource L.Menu.Diagnostics}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,6" />
                        <Button Content="{DynamicResource L.Menu.Logs}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Stretch" Command="{Binding ShowLogsCommand}" />

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource Brush.Border}"
                                Margin="0,12,0,12" />

                        <!-- Appearance section -->
                        <TextBlock Text="{DynamicResource L.Settings.Theme}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton Content="{DynamicResource L.Settings.Theme.Dark}" GroupName="MenuTheme"
                                         Foreground="{StaticResource Brush.Text}"
                                         IsChecked="{Binding ThemeIsDark}" Margin="0,0,20,0" />
                            <RadioButton Content="{DynamicResource L.Settings.Theme.Light}" GroupName="MenuTheme"
                                         Foreground="{StaticResource Brush.Text}"
                                         IsChecked="{Binding ThemeIsLight}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource L.Settings.Theme.RestartHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource Brush.Border}"
                                Margin="0,12,0,12" />

                        <!-- Maintenance section -->
                        <TextBlock Text="{DynamicResource L.Menu.Maintenance}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding CacheStatusText}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding CacheStatusText, Converter={StaticResource NullToCollapsed}}" />

                        <!-- Breakdown from the last check: what is taking the space. -->
                        <ItemsControl ItemsSource="{Binding CacheGroups}" Margin="0,0,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4" ToolTip="{Binding Path}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                                   Style="{StaticResource Text.Caption}"
                                                   FontWeight="SemiBold" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding CacheTotalText}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Margin="0,0,0,8"
                                   Visibility="{Binding CacheTotalText, Converter={StaticResource NullToCollapsed}}" />

                        <!-- Indeterminate while measuring (a scan has no total), then a
                             real bar driven by bytes deleted. -->
                        <ProgressBar Style="{StaticResource Progress.Slim}" Minimum="0" Maximum="1"
                                     Value="{Binding CacheProgress}"
                                     IsIndeterminate="{Binding IsScanningCache}"
                                     Margin="0,0,0,8"
                                     Visibility="{Binding IsCacheBusy, Converter={StaticResource BoolToVis}}" />

                        <Button Content="{DynamicResource L.Menu.CheckCache}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Stretch" Command="{Binding CheckCacheCommand}"
                                IsEnabled="{Binding IsCacheBusy, Converter={StaticResource InverseBool}}"
                                Margin="0,0,0,8" />
                        <Button Content="{DynamicResource L.Menu.ClearCache}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Stretch" Command="{Binding ClearCacheCommand}"
                                IsEnabled="{Binding IsCacheBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>

        <!-- ===== Background operations circle + list ===== -->
        <!-- Top-right, immediately left of the gear, so running work sits in the window's
             chrome rather than floating over page content at the bottom. Hidden entirely
             until there is an operation, keeping the window unchanged for anyone who leaves
             multitasking off. -->
        <Grid x:Name="OpsCorner" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,8,50,0" Panel.ZIndex="20"
              DataContext="{Binding Operations}"
              Visibility="{Binding HasOperations, Converter={StaticResource BoolToVis}}">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="OpsCircleScale" CenterX="17" CenterY="17" />
            </Grid.RenderTransform>

            <!-- 34px to match the gear button beside it. -->
            <Button x:Name="OpsButton" Width="34" Height="34" Padding="0" Cursor="Hand"
                    Command="{Binding ToggleListCommand}"
                    ToolTip="{DynamicResource L.Ops.Title}"
                    Background="Transparent" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Track, then the arc that sweeps round it clockwise from the
                                 top as the work completes. -->
                            <Ellipse Stroke="{StaticResource Brush.Border}" StrokeThickness="3"
                                     Fill="{StaticResource Brush.Surface}" Margin="1.5" />
                            <Path Stroke="{StaticResource Brush.Accent}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{Binding OverallProgress,
                                         Converter={StaticResource PercentToArc},
                                         ConverterParameter=34}" />

                            <!-- Number of operations still working; the glyph stands in once
                                 they have all finished so the circle never reads as "0". -->
                            <TextBlock Text="{Binding RunningCount}" Style="{StaticResource Text.Body}"
                                       FontWeight="SemiBold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasRunning, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Drops below the button now that it lives in the top chrome; offset left so the
                 310px panel stays inside the window instead of hanging off the right edge. -->
            <Popup IsOpen="{Binding IsListOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=OpsButton}"
                   Placement="Bottom" HorizontalOffset="-268" VerticalOffset="6"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{StaticResource Brush.Surface}" CornerRadius="12"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        Width="310" Padding="16" Margin="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Ops.Title}" Style="{StaticResource Text.Body}"
                                   FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />

                        <!-- Capped like the gear menu: several operations would otherwise run
                             off the bottom of a short window, and a popup is its own top-level
                             window so nothing would clip it. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="{Binding ActualHeight, ElementName=Root,
                                                  Converter={StaticResource Subtract}, ConverterParameter=160}">
                            <ItemsControl ItemsSource="{Binding Operations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Brush.SurfaceHover}" CornerRadius="8"
                                                Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />

                                                <ProgressBar Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                                             Value="{Binding Progress, Mode=OneWay}"
                                                             Background="{StaticResource Brush.Border}"
                                                             Foreground="{StaticResource Brush.Accent}"
                                                             BorderThickness="0"
                                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Caption}"
                                                           Margin="0,6,0,0" />

                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="{DynamicResource L.Ops.Return}"
                                                            Style="{StaticResource Button.Secondary}"
                                                            HorizontalAlignment="Stretch"
                                                            Command="{Binding DataContext.ReturnCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Grid.Column="2"
                                                            Content="{DynamicResource L.Ops.Cancel}"
                                                            Style="{StaticResource Button.Secondary}"
                                                            HorizontalAlignment="Stretch"
                                                            Command="{Binding DataContext.CancelOneCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Content="{DynamicResource L.Ops.ClearFinished}"
                                Style="{StaticResource Button.Secondary}" HorizontalAlignment="Stretch"
                                Command="{Binding ClearFinishedOperationsCommand}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</Window>
