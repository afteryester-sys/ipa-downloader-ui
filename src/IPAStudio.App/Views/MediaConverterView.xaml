<UserControl x:Class="IPAStudio.App.Views.MediaConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IPAStudio.App.Converters"
             AllowDrop="True"
             Drop="OnDrop"
             DragOver="OnDragOver">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,56,0">
                <Button Content="{DynamicResource L.Back}" Style="{StaticResource Button.Back}"
                        Command="{Binding BackCommand}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.MediaConverter.Title}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{DynamicResource L.MediaConverter.Subtitle}"
                               Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== Main Content ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Controls & Options -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,24,0">
                <StackPanel>
                    <!-- Mode / Filter Switcher -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.MediaConverter.ModeTitle}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <UniformGrid Columns="2" Rows="2" Margin="-3">
                                <RadioButton Content="{DynamicResource L.MediaConverter.TabPhotos}" GroupName="ConvTab"
                                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=0, Mode=TwoWay}"
                                             Margin="3" Style="{StaticResource Toggle.Pill}" />
                                <RadioButton Content="{DynamicResource L.MediaConverter.TabVideos}" GroupName="ConvTab"
                                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=1, Mode=TwoWay}"
                                             Margin="3" Style="{StaticResource Toggle.Pill}" />
                                <RadioButton Content="{DynamicResource L.MediaConverter.TabLivePhotos}" GroupName="ConvTab"
                                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=2, Mode=TwoWay}"
                                             Margin="3" Style="{StaticResource Toggle.Pill}" />
                                <RadioButton Content="{DynamicResource L.MediaConverter.TabAll}" GroupName="ConvTab"
                                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=3, Mode=TwoWay}"
                                             Margin="3" Style="{StaticResource Toggle.Pill}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Source Selection Card -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.MediaConverter.SourceLabel}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource L.MediaConverter.SourceHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{DynamicResource L.MediaConverter.PickFolder}"
                                        Style="{StaticResource Button.Secondary}" Margin="0,0,4,0"
                                        Command="{Binding BrowseSourceFolderCommand}"
                                        IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBool}}" />
                                <Button Grid.Column="1" Content="{DynamicResource L.MediaConverter.PickFiles}"
                                        Style="{StaticResource Button.Secondary}" Margin="4,0,0,0"
                                        Command="{Binding BrowseSourceFilesCommand}"
                                        IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBool}}" />
                            </Grid>

                            <CheckBox Content="{DynamicResource L.MediaConverter.IncludeSubdirs}"
                                      IsChecked="{Binding IncludeSubdirectories}"
                                      IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBool}}"
                                      Margin="0,0,0,6" />
                        </StackPanel>
                    </Border>

                    <!-- Destination Card -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.MediaConverter.DestLabel}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource L.MediaConverter.DestHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,10" />

                            <RadioButton Content="{DynamicResource L.MediaConverter.SaveInSource}" GroupName="DestMode"
                                         IsChecked="{Binding SaveInSourceFolder}" Margin="0,0,0,8"
                                         IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBool}}" />
                            <RadioButton Content="{DynamicResource L.MediaConverter.SaveInCustom}" GroupName="DestMode"
                                         IsChecked="{Binding SaveInSourceFolder, Converter={StaticResource InverseBool}}" Margin="0,0,0,8"
                                         IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBool}}" />

                            <Grid Margin="0,0,0,8" Visibility="{Binding SaveInSourceFolder, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource Input.TextBox}"
                                         Text="{Binding DestinationFolderPath}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="{DynamicResource L.MediaExport.Browse}"
                                        Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                        Command="{Binding BrowseDestinationFolderCommand}"
                                        IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBool}}" />
                            </Grid>

                            <CheckBox Content="{DynamicResource L.MediaConverter.PreserveSubdirs}"
                                      IsChecked="{Binding PreserveSubdirectories}"
                                      Visibility="{Binding SaveInSourceFolder, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                      IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBool}}"
                                      Margin="0,0,0,6" />

                            <CheckBox Content="{DynamicResource L.MediaConverter.DeleteOriginals}"
                                      IsChecked="{Binding DeleteOriginals}"
                                      IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBool}}"
                                      Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Conversion Options Card -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.MediaConverter.OptionsLabel}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,10" />

                            <!-- Photo Quality -->
                            <TextBlock Text="{DynamicResource L.MediaConverter.JpegQuality}" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="60" Maximum="100" Value="{Binding JpegQuality}"
                                        SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1"
                                        IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBool}}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding JpegQuality, StringFormat='{}{0}%'}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Video Quality -->
                            <TextBlock Text="{DynamicResource L.MediaConverter.VideoPreset}" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding VideoQuality}"
                                      IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBool}}"
                                      Margin="0,0,0,10">
                                <ComboBoxItem Content="MP4 • Авто (исходное качество)" Tag="auto" IsSelected="True" />
                                <ComboBoxItem Content="MP4 • 1080p Full HD" Tag="1080p" />
                                <ComboBoxItem Content="MP4 • 720p HD" Tag="720p" />
                            </ComboBox>

                            <!-- Live Photo Mode -->
                            <TextBlock Text="{DynamicResource L.MediaConverter.LivePhotoMode}" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <ComboBox SelectedIndex="{Binding LivePhotoMode, Mode=TwoWay}"
                                      IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBool}}">
                                <ComboBoxItem Content="JPEG + MP4 (Универсальный)" IsSelected="True" />
                                <ComboBoxItem Content="Анимированный GIF" />
                                <ComboBoxItem Content="Только MP4 (Видео)" />
                                <ComboBoxItem Content="Только JPEG (Фото)" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Panel: Items List & Actions -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- List Header & Summary -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L.MediaConverter.ItemsList}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                        <Border Margin="10,0,0,0" CornerRadius="10" Background="{DynamicResource Brush.SurfaceHover}" Padding="8,2">
                            <TextBlock Text="{Binding VisibleItems.Count, StringFormat='{}{0}'}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1" Content="{DynamicResource L.MediaConverter.ClearList}"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding ClearItemsCommand}"
                            IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBool}}"
                            Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- Items List or Empty State -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                    <Grid>
                        <!-- Empty Dropzone State -->
                        <Grid Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Brush.AccentSoft}"
                                        HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{DynamicResource L.MediaConverter.DropzoneTitle}"
                                           Style="{StaticResource Text.Body}" FontWeight="SemiBold" FontSize="15"
                                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="{DynamicResource L.MediaConverter.DropzoneHint}"
                                           Style="{StaticResource Text.Caption}" FontSize="12"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" />
                            </StackPanel>
                        </Grid>

                        <!-- Items List -->
                        <ListView ItemsSource="{Binding VisibleItems}"
                                  Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Kind Icon -->
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                                    Background="{DynamicResource Brush.SurfaceHover}" Margin="0,0,12,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                           Foreground="{DynamicResource Brush.Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xEB9F;" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Video">
                                                                    <Setter Property="Text" Value="&#xE714;" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="LivePhotoPair">
                                                                    <Setter Property="Text" Value="&#xE768;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- File Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SourcePath}" Style="{StaticResource Text.Caption}"
                                                           FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                            </StackPanel>

                                            <!-- Size -->
                                            <TextBlock Grid.Column="2" Text="{Binding FormattedSize}"
                                                       Style="{StaticResource Text.Caption}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="12,0,16,0" />

                                            <!-- Status -->
                                            <Border Grid.Column="3" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                    Background="{DynamicResource Brush.SurfaceHover}">
                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Bottom Progress & Action Row -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Progress Section -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12"
                                Visibility="{Binding IsConverting, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding ConversionProgress, StringFormat='{}{0:F0}%'}"
                                       FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ConversionProgress}" />
                    </StackPanel>

                    <!-- Completed Summary -->
                    <Border Grid.Row="0" Margin="0,0,0,12" Background="{DynamicResource Brush.AccentSoft}"
                            CornerRadius="8" Padding="12,8"
                            Visibility="{Binding HasCompleted, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SummaryText}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{DynamicResource L.MediaConverter.OpenDest}"
                                    Style="{StaticResource Button.Secondary}"
                                    Command="{Binding OpenDestinationCommand}" Margin="12,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource L.Cancel}"
                                Style="{StaticResource Button.Danger}" MinWidth="110" Margin="0,0,10,0"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsConverting, Converter={StaticResource BoolToVis}}" />

                        <Button Style="{StaticResource Button.Primary}" MinWidth="180"
                                Command="{Binding ConvertCommand}"
                                IsEnabled="{Binding HasItems}"
                                Visibility="{Binding IsConverting, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.MediaConverter.StartConvert}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
