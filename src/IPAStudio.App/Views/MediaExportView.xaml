<UserControl x:Class="IPAStudio.App.Views.MediaExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IPAStudio.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,56,0">
                <Button Content="{DynamicResource L.Back}" Style="{StaticResource Button.Back}"
                        Command="{Binding GoBackCommand}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Style="{StaticResource Button.Home}"
                        Command="{Binding GoHomeCommand}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.MediaExport.Title}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{DynamicResource L.MediaExport.Subtitle}"
                               Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">

                <!-- ===== Step 1: source ===== -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.MediaExport.SourceLabel}"
                                   Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource L.MediaExport.SourceHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Margin="0,2,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{StaticResource Input.TextBox}"
                                     Text="{Binding SourcePath}"
                                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                     VerticalAlignment="Center" IsReadOnly="True" />

                            <Button Grid.Column="1" Content="{DynamicResource L.MediaExport.Browse}"
                                    Style="{StaticResource Button.Secondary}" Margin="10,0,0,0"
                                    Command="{Binding BrowseSourceCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Step 2: destination ===== -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.MediaExport.DestinationLabel}"
                                   Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource L.MediaExport.DestinationHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Margin="0,2,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{StaticResource Input.TextBox}"
                                     Text="{Binding DestinationPath}"
                                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                     VerticalAlignment="Center" IsReadOnly="True" />

                            <Button Grid.Column="1" Content="{DynamicResource L.MediaExport.Browse}"
                                    Style="{StaticResource Button.Secondary}" Margin="10,0,0,0"
                                    Command="{Binding BrowseDestinationCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Options ===== -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.MediaExport.OptionsLabel}"
                                   Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Content="{DynamicResource L.MediaExport.ByFolder}" GroupName="ExportLayout"
                                         Foreground="{StaticResource Brush.Text}"
                                         IsChecked="{Binding ByFolder}" Margin="0,0,20,0"
                                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <RadioButton Content="{DynamicResource L.MediaExport.SingleFolder}" GroupName="ExportLayout"
                                         Foreground="{StaticResource Brush.Text}"
                                         IsChecked="{Binding SingleFolder}"
                                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        </StackPanel>

                        <CheckBox Content="{DynamicResource L.MediaExport.SkipJunk}"
                                  Foreground="{StaticResource Brush.Text}"
                                  IsChecked="{Binding SkipJunk}"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <TextBlock Text="{DynamicResource L.MediaExport.SkipJunkHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- ===== Action row ===== -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="{DynamicResource L.MediaExport.Scan}"
                            Style="{StaticResource Button.Primary}" MinWidth="160"
                            Command="{Binding ScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                    <Button Content="{DynamicResource L.MediaExport.Export}"
                            Style="{StaticResource Button.Primary}" MinWidth="160" Margin="10,0,0,0"
                            Command="{Binding ExportCommand}"
                            Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}" />

                    <Button Content="{DynamicResource L.Direct.Cancel}"
                            Style="{StaticResource Button.Danger}" MinWidth="120" Margin="10,0,0,0"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                    <Button Content="{DynamicResource L.MediaExport.OpenDestination}"
                            Style="{StaticResource Button.Secondary}" Margin="10,0,0,0"
                            Command="{Binding OpenDestinationCommand}"
                            Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- ===== Scan results ===== -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"
                        Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalFoundText}" Style="{StaticResource Text.Body}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SkippedJunkText}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding SkippedJunkText, Converter={StaticResource NullToCollapsed}}" />

                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                                   Style="{StaticResource Text.Caption}" FontWeight="SemiBold">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                                    <Binding Path="PhotoCount" />
                                                    <Binding Path="VideoCount" />
                                                    <Binding Path="SizeText" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== Progress + status ===== -->
                <StackPanel Margin="0,0,0,12"
                            Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Style="{StaticResource Progress.Slim}" Minimum="0" Maximum="100"
                                 Value="{Binding ExportProgress, Mode=OneWay}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />

                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Caption}"
                           Foreground="{StaticResource Brush.Danger}"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
