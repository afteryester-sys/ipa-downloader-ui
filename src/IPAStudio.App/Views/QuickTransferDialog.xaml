<Window x:Class="IPAStudio.App.Views.QuickTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.QuickTransfer.Title}"
        Width="520" Height="480"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}"
        AllowDrop="True"
        DragOver="OnDragOver"
        DragLeave="OnDragLeave"
        Drop="OnDrop">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource L.QuickTransfer.Title}"
                   Style="{StaticResource Text.Body}"
                   FontSize="17" FontWeight="SemiBold" />

        <!-- Names the device so a dialog opened on the wrong card is obvious before anything
             is dropped into it. -->
        <TextBlock x:Name="DeviceLine" Grid.Row="1"
                   Style="{StaticResource Text.Caption}"
                   TextWrapping="Wrap" Margin="0,4,0,14" />

        <!-- ===== Empty state: the drop target itself ===== -->
        <!-- BorderBrush is flipped to the accent colour from code-behind while something
             draggable is over the window, the same on/off signal the Photos page drop
             overlay uses, so the box reads as "about to accept this" rather than as
             permanent chrome. -->
        <Border x:Name="DropZone" Grid.Row="2"
                CornerRadius="10" BorderThickness="2"
                BorderBrush="{StaticResource Brush.Border}"
                Background="{StaticResource Brush.Surface}">
            <Grid>
                <!-- Nothing recognised yet: matches iMazing's own empty state, a dashed well
                     with a single downward arrow and a manual fallback for anyone who would
                     rather browse than drag. -->
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                               Foreground="{StaticResource Brush.TextMuted}"
                               HorizontalAlignment="Center" Opacity="0.6" />
                    <TextBlock Text="{DynamicResource L.QuickTransfer.DropHint}"
                               Style="{StaticResource Text.Body}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,14,0,0" MaxWidth="320" />
                    <Button Content="{DynamicResource L.QuickTransfer.Browse}"
                            Style="{StaticResource Button.Secondary}"
                            HorizontalAlignment="Center" Margin="0,16,0,0"
                            Click="OnBrowseClicked" />
                    <TextBlock Text="{DynamicResource L.QuickTransfer.Supported}"
                               Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,14,0,0" MaxWidth="340" />
                </StackPanel>

                <!-- ===== Recognised files, grouped by destination ===== -->
                <StackPanel x:Name="ResultState" Visibility="Collapsed" Margin="20">
                    <TextBlock x:Name="SummaryLine"
                               Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap" Margin="0,0,0,16" />
                    <!-- Tiles are built directly in code-behind, one per destination: each drop
                         produces at most the two this app knows how to route (Camera Roll,
                         Apps), so a data-bound template would be more machinery than the two
                         shapes it will ever draw. -->
                    <WrapPanel x:Name="DestinationTiles" Orientation="Horizontal" />
                </StackPanel>

                <!-- ===== Transfer in progress: photo copy is the only part worth a bar, the
                     app install runs as a background operation the moment Transfer is
                     pressed and is tracked from the corner circle instead. ===== -->
                <StackPanel x:Name="ProgressState" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                    <TextBlock x:Name="ProgressLabel"
                               Style="{StaticResource Text.Body}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    <ProgressBar x:Name="ProgressBarControl" Style="{StaticResource Progress.Slim}"
                                 Margin="0,14,0,0" Minimum="0" Maximum="100" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Footer ===== -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="{DynamicResource L.Cancel}"
                    Style="{StaticResource Button.Ghost}"
                    MinWidth="110" Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancelClicked" />
            <Button x:Name="TransferButton" Content="{DynamicResource L.QuickTransfer.Transfer}"
                    Style="{StaticResource Button.Primary}"
                    MinWidth="140"
                    IsEnabled="False"
                    Click="OnTransferClicked" />
        </StackPanel>
    </Grid>
</Window>
