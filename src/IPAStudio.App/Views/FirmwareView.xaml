<UserControl x:Class="IPAStudio.App.Views.FirmwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IPAStudio.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <Style x:Key="FirmwareActionButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="MinWidth" Value="210" />
            <Setter Property="Padding" Value="22,12" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,56,0">
                <Button Content="{DynamicResource L.Back}" Style="{StaticResource Button.Back}" Command="{Binding GoBackCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Button.Home}" Command="{Binding GoHomeCommand}" Margin="0,0,16,0"/>
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Firmware.Title}" Style="{StaticResource Text.Title}"/>
                    <TextBlock Text="{DynamicResource L.Firmware.Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="110"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource L.Firmware.Catalog}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Text="{DynamicResource L.Firmware.CatalogHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <TextBox Grid.Row="2" Style="{StaticResource Input.TextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <ListBox Grid.Row="3" ItemsSource="{Binding CatalogDevices}" SelectedItem="{Binding SelectedCatalogDevice}" DisplayMemberPath="DisplayName" BorderThickness="0" Background="Transparent" Margin="0,8,0,8"/>
                    <Button Grid.Row="4" Content="{DynamicResource L.Firmware.AddDevice}" Style="{StaticResource Button.Primary}" Command="{Binding AddDeviceCommand}" HorizontalAlignment="Stretch"/>
                    <Grid Grid.Row="5" Margin="0,18,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource L.Firmware.MyDevices}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="10" Padding="8,2"><TextBlock Text="{Binding MyDevices.Count}" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold"/></Border>
                        </DockPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding MyDevices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName" BorderThickness="0" Background="Transparent"/>
                    </Grid>
                    <Button Grid.Row="6" Content="{DynamicResource L.Firmware.RemoveDevice}" Style="{StaticResource Button.Secondary}" Command="{Binding RemoveDeviceCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource L.Firmware.Release}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                <CheckBox DockPanel.Dock="Right" Content="{DynamicResource L.Firmware.SignedOnly}" IsChecked="{Binding SignedOnly}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Firmwares}" SelectedItem="{Binding SelectedFirmware}" MinHeight="150" MaxHeight="260" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Version}" FontWeight="SemiBold"/><TextBlock Text="{Binding BuildId}" Style="{StaticResource Text.Caption}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right"/><TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="{DynamicResource L.Firmware.AutoUpdate}" Style="{StaticResource Button.Secondary}" Command="{Binding ToggleAutoUpdateCommand}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.Firmware.Folder}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                            <Grid Margin="0,8,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Style="{StaticResource Input.TextBox}" Text="{Binding DestinationFolder}"/><Button Grid.Column="1" Content="{DynamicResource L.Direct.Browse}" Style="{StaticResource Button.Secondary}" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0"/></Grid>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource L.Firmware.Threads}" VerticalAlignment="Center"/><Slider Width="160" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SegmentCount}" Margin="12,0,0,0"/><TextBlock Text="{Binding SegmentCount}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="{DynamicResource L.Firmware.Interval}" VerticalAlignment="Center"/><Slider Width="160" Minimum="1" Maximum="168" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding AutoCheckIntervalHours}" Margin="12,0,0,0"/><TextBlock Text="{Binding AutoCheckIntervalHours}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Style="{StaticResource FirmwareActionButton}" Command="{Binding ToggleDownloadCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ActionBackground" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock x:Name="ActionIcon" Text="▶" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ActionText" Text="{DynamicResource L.Firmware.StartDownload}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                            <Setter TargetName="ActionIcon" Property="Text" Value="■"/>
                                            <Setter TargetName="ActionText" Property="Text" Value="{DynamicResource L.Firmware.StopDownload}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionBackground" Property="Opacity" Value="0.88"/></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionBackground" Property="Opacity" Value="0.72"/></Trigger>
                                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ActionBackground" Property="Opacity" Value="0.4"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="{DynamicResource L.Direct.OpenFolder}" Style="{StaticResource Button.Secondary}" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ProgressBar Style="{StaticResource Progress.Slim}" Minimum="0" Maximum="100" Value="{Binding Progress}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>
            </ScrollViewer>
            <ProgressBar Grid.ColumnSpan="3" IsIndeterminate="True" VerticalAlignment="Top" Height="3" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</UserControl>
