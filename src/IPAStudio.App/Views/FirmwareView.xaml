<UserControl x:Class="IPAStudio.App.Views.FirmwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IPAStudio.App.Converters"
             xmlns:vm="clr-namespace:IPAStudio.App.ViewModels">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:IntEqualsConverter x:Key="IntEquals" />
        <conv:IntEqualsToVisibilityConverter x:Key="IntEqualsToVis" />

        <!-- Selectable item row style with smooth hover and subtle accent border -->
        <Style x:Key="FirmwareSelectable" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="Fill" CornerRadius="8" Background="Transparent" />
                            <Border x:Name="Ring" CornerRadius="8" Opacity="0"
                                    BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1.5" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact pill button for table rows -->
        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="14,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MiniActionDanger" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        </Style>

        <!-- Segmented thread selection button with tactile hover and press scale -->
        <Style x:Key="SegmentThreadButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBg"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.05" Duration="0:0:0.1">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="BtnBg"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.05" Duration="0:0:0.1">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBg"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="BtnBg"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBg"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.94" Duration="0:0:0.07">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="BtnBg"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.94" Duration="0:0:0.07">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBg"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="BtnBg"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,20,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER CHROME & MODE SWITCHER ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Back, Home & View Titles -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource L.Back}" Style="{StaticResource Button.Back}"
                        Command="{Binding GoBackCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Button.Home}" Command="{Binding GoHomeCommand}" Margin="0,0,16,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L.Firmware.Title}" Style="{StaticResource Text.Title}" FontSize="24" />
                    <TextBlock Text="{DynamicResource L.Firmware.Subtitle}" Style="{StaticResource Text.Subtitle}"
                               FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <!-- Right: Segmented Mode Switcher & Settings Button (56px margin keeps clear of MainWindow gear button) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,56,0">
                <!-- Apple Segmented Control -->
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="2" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Tab 1: Мои устройства -->
                        <Button Command="{Binding SwitchToDevicesModeCommand}"
                                Padding="12,5" Cursor="Hand" BorderThickness="0" Margin="0,0,2,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="TabBg" Background="{TemplateBinding Background}" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                                    </Border.RenderTransform>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="TabBg"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.03" Duration="0:0:0.1">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="TabBg"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.03" Duration="0:0:0.1">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="TabBg"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.0" Duration="0:0:0.14">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="TabBg"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.0" Duration="0:0:0.14">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="TabBg"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="0.95" Duration="0:0:0.07">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="TabBg"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="0.95" Duration="0:0:0.07">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="TabBg"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.0" Duration="0:0:0.14">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="TabBg"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.0" Duration="0:0:0.14">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSingleDownloadMode}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <!-- Rounded Apple device silhouette with pill notch -->
                                <Border Width="11" Height="17" CornerRadius="2.5"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        BorderThickness="1.2" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Border Width="5" Height="1.2" CornerRadius="0.6"
                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            VerticalAlignment="Top" Margin="0,1.5,0,0" />
                                </Border>
                                <TextBlock Text="{DynamicResource L.Firmware.Tab.MyDevices}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MyDevices.Count, StringFormat=' ({0})'}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tab 2: Одиночное скачивание -->
                        <Button Command="{Binding SwitchToSingleModeCommand}"
                                Padding="12,5" Cursor="Hand" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="TabBg" Background="{TemplateBinding Background}" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                                    </Border.RenderTransform>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="TabBg"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.03" Duration="0:0:0.1">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="TabBg"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.03" Duration="0:0:0.1">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="TabBg"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.0" Duration="0:0:0.14">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="TabBg"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.0" Duration="0:0:0.14">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="TabBg"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="0.95" Duration="0:0:0.07">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="TabBg"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="0.95" Duration="0:0:0.07">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="TabBg"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.0" Duration="0:0:0.14">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="TabBg"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.0" Duration="0:0:0.14">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSingleDownloadMode}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.Firmware.Tab.SingleDownload}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ================= MAIN WORKSPACE BODY ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="200" MaxWidth="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="480" />
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT SIDEBAR ================= -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Devices Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource L.Firmware.MyDevices}" Style="{StaticResource Text.Caption}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="+ Добавить" ToolTip="{DynamicResource L.Firmware.AddDevicesTitle}"
                            Style="{StaticResource Button.Ghost}" Padding="6,2" FontSize="11"
                            Click="AddDevices_Click" HorizontalAlignment="Right" />
                </DockPanel>

                <!-- Monitored Devices List -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                    <Grid>
                        <!-- Empty state when no devices yet -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14"
                                     Visibility="{Binding MyDevices.Count, Converter={StaticResource IntEqualsToVis}, ConverterParameter=0}">
                            <!-- Circular badge container with rounded Apple device silhouette -->
                            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Brush.SurfaceHover}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Border Width="20" Height="32" CornerRadius="4" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1.6"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="8" Height="2" CornerRadius="1" Background="{DynamicResource Brush.Accent}"
                                            VerticalAlignment="Top" Margin="0,3,0,0" />
                                </Border>
                            </Border>
                            <TextBlock Text="Нет устройств" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" />
                            <TextBlock Text="Нажмите «+ Добавить», чтобы отслеживать прошивки"
                                       FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" TextAlignment="Center"
                                       TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding MyDevices}" SelectedItem="{Binding SelectedDevice}"
                                 ItemContainerStyle="{StaticResource FirmwareSelectable}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Circular device badge -->
                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                                Background="{DynamicResource Brush.SurfaceHover}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Border Width="10" Height="16" CornerRadius="2.5" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1.2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="4" Height="1" CornerRadius="0.5" Background="{DynamicResource Brush.Accent}"
                                                        VerticalAlignment="Top" Margin="0,1.5,0,0" />
                                            </Border>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Identifier}" Style="{StaticResource Text.Caption}" FontSize="10" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Padding="4,2"
                                                ToolTip="{DynamicResource L.Firmware.RemoveDevice}"
                                                Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center" Opacity="0.5">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Clean Apple-Style Auto-Check & TSS Monitoring Tile -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#30D158" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAutoCheckEnabled}" Value="False">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{DynamicResource L.Firmware.AutoCheck}" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock FontSize="10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                        <Setter Property="Text" Value="{DynamicResource L.Firmware.AutoCheck.On}" />
                                        <Setter Property="Foreground" Value="#30D158" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAutoCheckEnabled}" Value="False">
                                                <Setter Property="Text" Value="{DynamicResource L.Firmware.AutoCheck.Off}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <!-- Animated iOS Toggle Switch -->
                        <Border Grid.Column="1" Width="38" Height="22" CornerRadius="11" Padding="0"
                                Cursor="Hand" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding ToggleAutoCheckCommand}" />
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#30D158" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoCheckEnabled}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Canvas Width="38" Height="22">
                                <Ellipse Width="18" Height="18" Fill="White" Canvas.Top="2" Canvas.Left="2">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25" Color="#000000" />
                                    </Ellipse.Effect>
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="16" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAutoCheckEnabled}" Value="False">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                 To="0" Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                 To="16" Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Canvas>
                        </Border>
                        <!-- Subtle settings gear button -->
                        <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Width="26" Height="26" Padding="0"
                                Command="{Binding ToggleSettingsCommand}"
                                ToolTip="{DynamicResource L.Firmware.Settings.Title}" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= RIGHT COLUMN: MAIN CONTENT ================= -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- MODE 1: "МОИ УСТРОЙСТВА" TABLE & EMPTY STATE -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16"
                        Visibility="{Binding IsSingleDownloadMode, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <Grid>
                        <!-- Empty State: when no device is selected in the list -->
                        <Grid Visibility="{Binding SelectedDevice, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                                <!-- Circular container with rounded Apple device silhouette -->
                                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Brush.SurfaceHover}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                        HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <Border Width="24" Height="38" CornerRadius="4.5" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1.8"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="10" Height="2" CornerRadius="1" Background="{DynamicResource Brush.Accent}"
                                                VerticalAlignment="Top" Margin="0,3.5,0,0" />
                                    </Border>
                                </Border>
                                <TextBlock Text="Выберите устройство" FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="Выберите устройство из списка слева для просмотра доступных официальных прошивок и проверки статуса цифровой подписи Apple TSS, либо воспользуйтесь разовым скачиванием."
                                           Style="{StaticResource Text.Caption}" FontSize="12" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,0,0,20" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="+ Добавить устройство" Style="{StaticResource Button.Primary}"
                                            Click="AddDevices_Click" Height="32" Padding="16,0" FontSize="12" Margin="0,0,10,0" />
                                    <Button Command="{Binding SwitchToSingleModeCommand}" Style="{StaticResource Button.Secondary}"
                                            Height="32" Padding="14,0" FontSize="12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Одиночное скачивание" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Device Selected Content -->
                        <Grid Visibility="{Binding SelectedDevice, Converter={StaticResource NullToCollapsed}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Controls Bar -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedDevice.Name, FallbackValue='Выберите устройство'}"
                                               FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{Binding SelectedDevice.Identifier, StringFormat=' ({0})'}"
                                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                                <CheckBox DockPanel.Dock="Right" Content="{DynamicResource L.Firmware.SignedOnly}"
                                          Style="{StaticResource Check.Base}" IsChecked="{Binding SignedOnly}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Table Header -->
                            <Grid Grid.Row="1" Background="{DynamicResource Brush.SurfaceHover}" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource L.Firmware.Release}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Margin="10,6" />
                                <TextBlock Grid.Column="1" Text="Сборка" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Margin="6,6" />
                                <TextBlock Grid.Column="2" Text="Статус TSS" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Margin="6,6" />
                                <TextBlock Grid.Column="3" Text="Размер" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Margin="6,6" />
                                <TextBlock Grid.Column="4" Text="Действие" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Margin="10,6" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Firmwares List & Loading/Empty indicator -->
                            <Grid Grid.Row="2">
                                <!-- Loading State -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar IsIndeterminate="True" Width="140" Height="4" Style="{StaticResource Progress.Slim}" Margin="0,0,0,10" />
                                    <TextBlock Text="Загрузка списка прошивок..." Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Empty list when loaded but 0 items -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Firmwares.Count}" Value="0" />
                                                        <Condition Binding="{Binding IsLoading}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Нет прошивок, соответствующих текущему фильтру"
                                               Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                                </StackPanel>

                                <ListBox ItemsSource="{Binding Firmwares}" SelectedItem="{Binding SelectedFirmware}"
                                         ItemContainerStyle="{StaticResource FirmwareSelectable}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.5*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="2.5*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Version -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Version, StringFormat='iOS {0}'}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding ReleaseDateText}" Style="{StaticResource Text.Caption}" FontSize="11" />
                                                </StackPanel>

                                                <!-- BuildId -->
                                                <TextBlock Grid.Column="1" Text="{Binding BuildId}" Style="{StaticResource Text.Caption}"
                                                           FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0" />

                                                <!-- TSS Status Badge -->
                                                <Border Grid.Column="2" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Signed}" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{DynamicResource L.Firmware.TssSigned}" />
                                                                <Setter Property="Foreground" Value="#30D158" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Signed}" Value="False">
                                                                        <Setter Property="Text" Value="{DynamicResource L.Firmware.TssUnsigned}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- File Size -->
                                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" Margin="6,0" FontSize="12" />

                                                <!-- Download Button -->
                                                <Button Grid.Column="4" Content="{DynamicResource L.Firmware.Single.DownloadOnce}"
                                                        Style="{StaticResource PillButton}"
                                                        Command="{Binding DataContext.DownloadFirmwareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- MODE 2: "⚡ ОДИНОЧНОЕ СКАЧИВАНИЕ" -->
                <Grid Grid.Row="0" Visibility="{Binding IsSingleDownloadMode, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Card: Device Catalog Dropdown & Direct URL -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,8,0">
                                        <TextBlock Text="⚡" FontSize="12" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource L.Firmware.Single.Title}" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{DynamicResource L.Firmware.Single.Subtitle}"
                                           Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>

                                <!-- Pick Apple Model -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource L.Firmware.Single.Model}" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AllDevices}" SelectedItem="{Binding SelectedSingleDevice}"
                                              DisplayMemberPath="DisplayName" Height="32" FontSize="12" Cursor="Hand" />
                                </StackPanel>

                                <!-- Direct IPSW URL -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource L.Firmware.Single.DirectUrl}" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding DirectUrlInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource Input.TextBox}" Height="32" Padding="8,4" FontSize="11"
                                                 FontFamily="Consolas" />
                                        <Button Grid.Column="1" Content="{DynamicResource L.Firmware.Single.DownloadUrl}"
                                                Style="{StaticResource Button.Primary}"
                                                Command="{Binding StartDirectUrlDownloadCommand}"
                                                Margin="6,0,0,0" Height="32" Padding="16,0" FontSize="12" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Firmwares Table for Single Selected Device -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
                        <Grid>
                            <!-- Empty State when no device chosen from dropdown -->
                            <Grid Visibility="{Binding SelectedSingleDevice, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                                <StackPanel HorizontalAlignment="Center">
                                    <!-- Circular container with rounded Apple device silhouette -->
                                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Brush.SurfaceHover}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <Border Width="24" Height="38" CornerRadius="4.5" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1.8"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="10" Height="2" CornerRadius="1" Background="{DynamicResource Brush.Accent}"
                                                    VerticalAlignment="Top" Margin="0,3.5,0,0" />
                                        </Border>
                                    </Border>
                                    <TextBlock Text="Выберите модель устройства в выпадающем списке выше"
                                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Либо вставьте прямую ссылку на .ipsw файл для мгновенной загрузки"
                                               Style="{StaticResource Text.Caption}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Single Device Selected Table -->
                            <Grid Visibility="{Binding SelectedSingleDevice, Converter={StaticResource NullToCollapsed}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Table Header -->
                                <Grid Grid.Row="0" Background="{DynamicResource Brush.SurfaceHover}" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="2.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource L.Firmware.Release}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Margin="10,6" />
                                    <TextBlock Grid.Column="1" Text="Сборка" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Margin="6,6" />
                                    <TextBlock Grid.Column="2" Text="Статус TSS" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Margin="6,6" />
                                    <TextBlock Grid.Column="3" Text="Размер" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Margin="6,6" />
                                    <TextBlock Grid.Column="4" Text="Действие" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Margin="10,6" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Single Firmwares List -->
                                <ListBox Grid.Row="1" ItemsSource="{Binding SingleFirmwares}"
                                         ItemContainerStyle="{StaticResource FirmwareSelectable}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.5*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="2.5*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Version -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Version, StringFormat='iOS {0}'}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding ReleaseDateText}" Style="{StaticResource Text.Caption}" FontSize="11" />
                                                </StackPanel>

                                                <!-- BuildId -->
                                                <TextBlock Grid.Column="1" Text="{Binding BuildId}" Style="{StaticResource Text.Caption}"
                                                           FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0" />

                                                <!-- TSS Status Badge -->
                                                <Border Grid.Column="2" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Signed}" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{DynamicResource L.Firmware.TssSigned}" />
                                                                <Setter Property="Foreground" Value="#30D158" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Signed}" Value="False">
                                                                        <Setter Property="Text" Value="{DynamicResource L.Firmware.TssUnsigned}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- File Size -->
                                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" Margin="6,0" FontSize="12" />

                                                <!-- Download Button -->
                                                <Button Grid.Column="4" Content="{DynamicResource L.Firmware.Single.DownloadOnce}"
                                                        Style="{StaticResource PillButton}"
                                                        Command="{Binding DataContext.DownloadSingleFirmwareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= SHARED BOTTOM DOWNLOAD QUEUE ================= -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,10,0,0"
                        Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Header Bar: Overall queue summary + global actions -->
                            <RowDefinition Height="Auto" />
                            <!-- Scrollable items list -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Bar -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L.Firmware.Queue.Title}" FontWeight="Bold" FontSize="13" Margin="0,0,8,0" />
                                <Border Background="{DynamicResource Brush.FirmwareSoft}" CornerRadius="10" Padding="8,2" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ActiveCount}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Firmware}" />
                                        <TextBlock Text=" активных" FontSize="11" Foreground="{DynamicResource Brush.Firmware}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding OverallSpeedText}" FontWeight="SemiBold" FontSize="12" Foreground="#30D158" Margin="4,0,8,0" />
                                <TextBlock Text="{Binding OverallSizeText}" Style="{StaticResource Text.Caption}" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Right-aligned action buttons -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{DynamicResource L.Firmware.PauseAll}" Style="{StaticResource Button.Secondary}"
                                        Height="26" Padding="10,0" FontSize="11" Margin="0,0,6,0"
                                        Command="{Binding PauseAllCommand}" />
                                <Button Content="{DynamicResource L.Firmware.ResumeAll}" Style="{StaticResource Button.Secondary}"
                                        Height="26" Padding="10,0" FontSize="11" Margin="0,0,6,0"
                                        Command="{Binding ResumeAllCommand}" />
                                <Button Content="{DynamicResource L.Firmware.ClearFinished}" Style="{StaticResource Button.Secondary}"
                                        Height="26" Padding="10,0" FontSize="11" Margin="0,0,6,0"
                                        Command="{Binding ClearFinishedCommand}" />
                                <Button Content="{DynamicResource L.Direct.OpenFolder}" Style="{StaticResource Button.Secondary}"
                                        Height="26" Padding="10,0" FontSize="11"
                                        Command="{Binding OpenFolderCommand}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Download Items Strips -->
                        <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Jobs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Brush.Background}" CornerRadius="8" Padding="12,10" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Icon Badge -->
                                                    <ColumnDefinition Width="Auto" />
                                                    <!-- Details + Progress -->
                                                    <ColumnDefinition Width="*" />
                                                    <!-- Controls -->
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Device / Apple Icon Badge -->
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                        Background="{DynamicResource Brush.FirmwareSoft}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Grid>
                                                        <!-- Regular Apple / Device Glyph -->
                                                        <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                                   Foreground="{DynamicResource Brush.Firmware}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <!-- Checkmark when finished -->
                                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                                   Foreground="#30D158"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Border>

                                                <!-- Main Job Progress Strip -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <DockPanel LastChildFill="False">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <!-- Single or Monitored Pill -->
                                                            <Border Background="{DynamicResource Brush.FirmwareSoft}" CornerRadius="4" Padding="6,1" Margin="8,0,4,0"
                                                                    Visibility="{Binding IsSingleDownload, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="⚡ Одиночное" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Firmware}" />
                                                            </Border>
                                                            <!-- State Badge -->
                                                            <Border CornerRadius="4" Padding="6,1" Margin="4,0,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding State}" Value="Running">
                                                                                <Setter Property="Background" Value="#2230D158" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="Paused">
                                                                                <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="WaitingSchedule">
                                                                                <Setter Property="Background" Value="{DynamicResource Brush.FirmwareSoft}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                                <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="Done">
                                                                                <Setter Property="Background" Value="#2230D158" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding StatusText}" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding State}" Value="Running">
                                                                                    <Setter Property="Foreground" Value="#30D158" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding State}" Value="Paused">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding State}" Value="WaitingSchedule">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Firmware}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding State}" Value="Done">
                                                                                    <Setter Property="Foreground" Value="#30D158" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Right: Speed and Remaining Time -->
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SpeedText}" FontWeight="SemiBold" FontSize="11" Foreground="#30D158" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Text.Caption}" FontSize="11" />
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <!-- Individual Progress Bar -->
                                                    <ProgressBar Style="{StaticResource Progress.Slim}" Height="5" Margin="0,6,0,4"
                                                                 Value="{Binding Progress}" Maximum="100" />

                                                    <!-- Bottom Subtitle / Sizes -->
                                                    <DockPanel LastChildFill="False">
                                                        <TextBlock Style="{StaticResource Text.Caption}" FontSize="11">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                                    <Binding Path="PercentText" />
                                                                    <Binding Path="SizeText" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" FontSize="10" Opacity="0.75" />
                                                    </DockPanel>
                                                </StackPanel>

                                                <!-- Individual Action Buttons -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Pause / Resume Button -->
                                                    <Button Width="28" Height="28" Padding="0" Margin="0,0,6,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                                                <Setter Property="Command" Value="{Binding PauseCommand}" />
                                                                <Setter Property="ToolTip" Value="Пауза" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanResume}" Value="True">
                                                                        <Setter Property="Command" Value="{Binding ResumeCommand}" />
                                                                        <Setter Property="ToolTip" Value="Возобновить загрузку" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#xE769;" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CanResume}" Value="True">
                                                                            <Setter Property="Text" Value="&#xE768;" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>

                                                    <!-- Stop / Remove Button -->
                                                    <Button Style="{StaticResource MiniActionDanger}" Command="{Binding StopCommand}"
                                                            Width="28" Height="28" Padding="0" ToolTip="Отменить и удалить">
                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= MODAL: IPSW SETTINGS SHEET ================= -->
        <Grid Grid.RowSpan="2" Background="#66000000" Panel.ZIndex="100"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="540" MaxHeight="620" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    UseLayoutRounding="True" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ModalScale" ScaleX="1.0" ScaleY="1.0" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ModalScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0.95" To="1.0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ModalScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0.95" To="1.0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- Modal Header -->
                    <DockPanel Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.FirmwareSoft}" Margin="0,0,12,0">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Brush.Firmware}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L.Firmware.Settings.Title}" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="{DynamicResource L.Firmware.Settings.Subtitle}" Style="{StaticResource Text.Caption}" FontSize="12" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Width="30" Height="30" Padding="0"
                                Command="{Binding CloseSettingsCommand}" HorizontalAlignment="Right" ToolTip="Закрыть">
                            <TextBlock Text="✕" FontSize="14" />
                        </Button>
                    </DockPanel>

                    <!-- Scrollable Settings Body -->
                    <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,6,0">
                            <!-- Group 1: Folder -->
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.Firmware.Folder}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding DestinationFolder}" Height="34" FontSize="12" FontFamily="Consolas" />
                                        <Button Grid.Column="1" Content="{DynamicResource L.Direct.Browse}" Style="{StaticResource Button.Secondary}"
                                                Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0" Height="34" Padding="14,0" FontSize="12" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Group 2: Parallel Threads -->
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L.Firmware.Threads}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Параллельные HTTP Range потоки ускоряют загрузку с CDN Apple" Style="{StaticResource Text.Caption}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.SurfaceHover}" CornerRadius="8" Padding="3"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Thread 2 -->
                                            <Button Content="2" Command="{Binding SetThreadsCommand}" CommandParameter="2">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentThreadButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SegmentCount}" Value="2">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Firmware}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Thread 4 -->
                                            <Button Content="4" Command="{Binding SetThreadsCommand}" CommandParameter="4">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentThreadButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SegmentCount}" Value="4">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Firmware}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Thread 8 -->
                                            <Button Content="8" Command="{Binding SetThreadsCommand}" CommandParameter="8">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentThreadButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SegmentCount}" Value="8">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Firmware}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Thread 16 -->
                                            <Button Content="16" Command="{Binding SetThreadsCommand}" CommandParameter="16">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentThreadButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SegmentCount}" Value="16">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Firmware}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                            </Border>

                            <!-- Group 3: Scheduled Night Downloads (Range e.g. 00:00 - 06:00) -->
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource L.Firmware.Schedule.Title}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{DynamicResource L.Firmware.Schedule.Hint}" Style="{StaticResource Text.Caption}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Check.Base}"
                                                  IsChecked="{Binding IsScheduleEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <!-- Range Selection Controls -->
                                    <Border Background="{DynamicResource Brush.SurfaceHover}" CornerRadius="8" Padding="12,10" Margin="0,6,0,0"
                                            Visibility="{Binding IsScheduleEnabled, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource L.Firmware.Schedule.From}" FontWeight="SemiBold" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableHours}" SelectedItem="{Binding ScheduleStartHour}"
                                                      ItemStringFormat="{}{0:D2}:00" Height="30" Margin="0,0,16,0" VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="2" Text="{DynamicResource L.Firmware.Schedule.To}" FontWeight="SemiBold" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableHours}" SelectedItem="{Binding ScheduleEndHour}"
                                                      ItemStringFormat="{}{0:D2}:00" Height="30" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Group 4: TSS Check Interval -->
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Периодичность автопроверки TSS" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Как часто опрашивать серверы Apple на наличие новых подписанных релизов" Style="{StaticResource Text.Caption}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider Width="90" Minimum="1" Maximum="72" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="{Binding AutoCheckIntervalHours}" Margin="0,0,10,0" />
                                        <Border Background="{DynamicResource Brush.FirmwareSoft}" CornerRadius="6" Padding="8,3" MinWidth="40">
                                            <TextBlock Text="{Binding AutoCheckIntervalHours, StringFormat='{}{0} ч'}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource Brush.Firmware}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Group 5: SHA Hash Verification -->
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L.Firmware.Settings.VerifySha}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{DynamicResource L.Firmware.Settings.VerifyShaHint}" Style="{StaticResource Text.Caption}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Check.Base}" IsChecked="{Binding VerifyHash}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <!-- Group 6: Clean Cache -->
                            <DockPanel Padding="0,4,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource L.Firmware.Settings.CleanCache}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{DynamicResource L.Firmware.Settings.CleanCacheHint}" Style="{StaticResource Text.Caption}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="{DynamicResource L.Firmware.Settings.CleanCache}"
                                        Style="{StaticResource MiniActionDanger}" Command="{Binding CleanCacheCommand}"
                                        Height="30" Padding="14,0" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Footer -->
                    <DockPanel>
                        <TextBlock Text="Все настройки сохраняются автоматически" Style="{StaticResource Text.Caption}"
                                   VerticalAlignment="Center" FontSize="12" />
                        <Button DockPanel.Dock="Right" Content="{DynamicResource L.Firmware.Settings.Apply}"
                                Style="{StaticResource Button.Primary}" Command="{Binding CloseSettingsCommand}"
                                Padding="24,8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
