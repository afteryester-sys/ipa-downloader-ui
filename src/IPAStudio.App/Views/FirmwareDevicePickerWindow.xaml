<Window x:Class="IPAStudio.App.Views.FirmwareDevicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.Firmware.AddDevicesTitle}" Width="640" Height="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Window}" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource L.Firmware.AddDevicesTitle}" Style="{StaticResource Text.Title}"/>
        <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource Input.TextBox}" Margin="0,16,0,12" TextChanged="SearchBox_TextChanged"/>
        <ListBox x:Name="DevicesList" Grid.Row="2" SelectionMode="Extended" DisplayMemberPath="DisplayName" BorderBrush="{DynamicResource Brush.Border}"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource L.Cancel}" Style="{StaticResource Button.Secondary}" Click="Cancel_Click"/>
            <Button Content="{DynamicResource L.Firmware.AddSelected}" Style="{StaticResource Button.Primary}" Click="Add_Click" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
