<Window x:Class="IPAStudio.App.Views.FirmwareDevicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.Firmware.AddDevicesTitle}"
        Width="660" Height="640" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Mirrors the archive picker in IpaCatalogsView: hover tints the row, selection
             fills it with the soft accent and draws an accent ring on top, so multi-select
             here reads exactly like selecting apps to install. -->
        <Style x:Key="PickerRow" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Fill" CornerRadius="8" Background="Transparent" />
                            <Border x:Name="Ring" CornerRadius="8" Opacity="0"
                                    BorderBrush="{StaticResource Brush.Accent}" BorderThickness="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{StaticResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Ring" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{StaticResource Brush.AccentSoft}" />
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource L.Firmware.AddDevicesTitle}" Style="{StaticResource Text.Body}"
                       FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource L.Firmware.PickerHint}" Style="{StaticResource Text.Caption}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource Input.TextBox}"
                 Margin="0,0,0,10" TextChanged="SearchBox_TextChanged" />

        <Border Grid.Row="2" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}" Padding="6">
            <ListBox x:Name="DevicesList" SelectionMode="Extended"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource PickerRow}"
                     DisplayMemberPath="DisplayName"
                     SelectionChanged="DevicesList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="CountLabel" Grid.Column="0" Style="{StaticResource Text.Caption}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,12,0" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource L.Cancel}" Style="{StaticResource Button.Secondary}"
                        MinWidth="110" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="AddButton" Content="{DynamicResource L.Firmware.AddSelected}"
                        Style="{StaticResource Button.Primary}" MinWidth="170" Click="Add_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
