<UserControl x:Class="IPAStudio.App.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IPAStudio.App.Converters"
             xmlns:models="clr-namespace:IPAStudio.Core.Models;assembly=IPAStudio.Core">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:IconPathConverter x:Key="IconPath" />

        <!-- Segmented period toggle button style -->
        <Style x:Key="PeriodButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        </Style>

        <!-- Stat Card Style -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header Row ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Back, Home and Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding GoBackCommand}" Style="{StaticResource Button.Ghost}"
                        Padding="8,6" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{DynamicResource L.Back}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource L.Back}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding GoHomeCommand}" Style="{StaticResource Button.Ghost}"
                        Width="32" Height="32" Padding="0" Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="{DynamicResource L.Home}">
                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Brush.SurfaceHover}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Brush.Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L.Stats.Title}" Style="{StaticResource Text.Title}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource L.Stats.Subtitle}" Style="{StaticResource Text.Caption}" FontSize="11.5" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Period Switcher & Actions (Right) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Segmented Control Container -->
                <Border Background="{DynamicResource Brush.SurfaceHover}" CornerRadius="8" Padding="2" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Today -->
                        <Button Content="{DynamicResource L.Stats.Period.Today}"
                                Command="{Binding SetPeriodCommand}" CommandParameter="Today">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PeriodButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPeriod}" Value="{x:Static models:StatisticsPeriod.Today}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Week (7 days) -->
                        <Button Content="{DynamicResource L.Stats.Period.Week}"
                                Command="{Binding SetPeriodCommand}" CommandParameter="Week">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PeriodButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPeriod}" Value="{x:Static models:StatisticsPeriod.Week}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Month (30 days) -->
                        <Button Content="{DynamicResource L.Stats.Period.Month}"
                                Command="{Binding SetPeriodCommand}" CommandParameter="Month">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PeriodButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPeriod}" Value="{x:Static models:StatisticsPeriod.Month}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Year (365 days) -->
                        <Button Content="{DynamicResource L.Stats.Period.Year}"
                                Command="{Binding SetPeriodCommand}" CommandParameter="Year">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PeriodButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPeriod}" Value="{x:Static models:StatisticsPeriod.Year}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- All Time -->
                        <Button Content="{DynamicResource L.Stats.Period.AllTime}"
                                Command="{Binding SetPeriodCommand}" CommandParameter="AllTime">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PeriodButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPeriod}" Value="{x:Static models:StatisticsPeriod.AllTime}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Refresh Button -->
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}"
                        Width="32" Height="32" Padding="0" Margin="0,0,6,0" ToolTip="{DynamicResource L.Refresh}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Clear Stats Button -->
                <Button Command="{Binding ClearStatsCommand}" Style="{StaticResource Button.Ghost}"
                        Width="32" Height="32" Padding="0" ToolTip="{DynamicResource L.Stats.Clear}">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Brush.TextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Row 1: KPI Metric Cards (4 cards, unified calm style) ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: App Installs -->
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource L.Stats.Card.Installs}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PeriodTitle}" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBlock Text="{Binding TotalInstalls}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource L.Stats.TodayPrefix}" Style="{StaticResource Text.Caption}" FontSize="11" />
                        <TextBlock Text="{Binding TodayInstalls}" Style="{StaticResource Text.Caption}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Devices Served -->
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource L.Stats.Card.Devices}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock DockPanel.Dock="Right" Text="{DynamicResource L.Stats.Badge.Unique}" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBlock Text="{Binding UniqueDevices}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource L.Stats.ConnectionsCount}" Style="{StaticResource Text.Caption}" FontSize="11" />
                        <TextBlock Text="{Binding TotalConnections}" Style="{StaticResource Text.Caption}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: IPA Downloads -->
            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource L.Stats.Card.Ipa}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding IpaVolumeText}" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBlock Text="{Binding TotalIpaDownloads}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource L.Stats.VolumePrefix}" Style="{StaticResource Text.Caption}" FontSize="11" />
                        <TextBlock Text="{Binding IpaVolumeText}" Style="{StaticResource Text.Caption}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 4: Firmware Downloads -->
            <Border Grid.Column="6" Style="{StaticResource StatCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource L.Stats.Card.Firmwares}" Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding FirmwareVolumeText}" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBlock Text="{Binding TotalFirmwareDownloads}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource L.Stats.VolumePrefix}" Style="{StaticResource Text.Caption}" FontSize="11" />
                        <TextBlock Text="{Binding FirmwareVolumeText}" Style="{StaticResource Text.Caption}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Row 2: Charts and Detailed Breakdown ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Activity Chart & Recent Log -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Activity Bar Chart Card -->
                <Border Grid.Row="0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource L.Stats.Chart.Activity}" FontWeight="SemiBold" FontSize="13" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource Brush.Accent}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.Stats.Legend.Installs}" Style="{StaticResource Text.Caption}" FontSize="10.5" Margin="0,0,12,0" />
                                <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource Brush.Border}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.Stats.Legend.Downloads}" Style="{StaticResource Text.Caption}" FontSize="10.5" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Bars UniformGrid -->
                        <Border Height="110" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Margin="0,0,0,6">
                            <ItemsControl ItemsSource="{Binding Timeline}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Bottom" Margin="4,0" HorizontalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding Installs}" FontSize="9.5" Foreground="{DynamicResource Brush.TextMuted}"
                                                       HorizontalAlignment="Center" Margin="0,0,0,3"
                                                       Visibility="{Binding Installs, Converter={StaticResource BoolToVis}}" />
                                            <Border Grid.Row="1" Width="12" Height="{Binding BarHeight}" CornerRadius="3,3,0,0"
                                                    Background="{DynamicResource Brush.Accent}" VerticalAlignment="Bottom"
                                                    ToolTip="{Binding Label}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- X-Axis Labels -->
                        <ItemsControl ItemsSource="{Binding Timeline}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" FontSize="9.5" Foreground="{DynamicResource Brush.TextMuted}"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Recent Activity Feed -->
                <Border Grid.Row="2" Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource L.Stats.RecentActivity}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.Stats.NoActivity}" Foreground="{DynamicResource Brush.TextMuted}"
                                           FontSize="11" HorizontalAlignment="Center" Margin="0,20"
                                           Visibility="{Binding RecentActivity.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <ItemsControl ItemsSource="{Binding RecentActivity}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8" Margin="0,0,0,4" Background="{DynamicResource Brush.SurfaceHover}" CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- App Icon / Default squircle -->
                                                    <Grid Grid.Column="0" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Border CornerRadius="7" Background="{DynamicResource Brush.Surface}">
                                                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border CornerRadius="7"
                                                                Visibility="{Binding IconPath, Converter={StaticResource NullToCollapsed}}">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding IconPath, Converter={StaticResource IconPath}}"
                                                                            Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" FontSize="9.5" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource Text.Caption}" FontSize="10"
                                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Column: Top Apps, Methods & Devices -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Top Apps Card with Real App Icons / Fallback Default -->
                    <Border Style="{StaticResource StatCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.Stats.TopApps}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding TopApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- App Icon / Default Squircle -->
                                            <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Border CornerRadius="8" Background="{DynamicResource Brush.SurfaceHover}">
                                                    <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                               Foreground="{DynamicResource Brush.TextMuted}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border CornerRadius="8"
                                                        Visibility="{Binding IconPath, Converter={StaticResource NullToCollapsed}}">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding IconPath, Converter={StaticResource IconPath}}"
                                                                    Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>

                                            <!-- App Title & Bundle ID -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" FontSize="9.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Count and % -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding CountText}" FontWeight="Bold" FontSize="11.5"
                                                           HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Accent}" />
                                                <TextBlock Text="{Binding PercentageText}" Style="{StaticResource Text.Caption}" FontSize="9.5"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Methods Breakdown Card -->
                    <Border Style="{StaticResource StatCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.Stats.Methods}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Methods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0" Margin="0,0,0,3">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" FontSize="10.5" HorizontalAlignment="Right">
                                                    <Run Text="{Binding Count, Mode=OneWay}" />
                                                    <Run Text=" (" /><Run Text="{Binding PercentageText, Mode=OneWay}" /><Run Text=")" />
                                                </TextBlock>
                                            </DockPanel>
                                            <ProgressBar Grid.Row="1" Height="4" Maximum="100" Value="{Binding Percentage, Mode=OneWay}"
                                                         BorderThickness="0" Background="{DynamicResource Brush.Border}" Foreground="{DynamicResource Brush.Accent}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Top Devices Card -->
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.Stats.TopDevices}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding TopDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Brush.SurfaceHover}" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" FontSize="9.5" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CountText}" FontWeight="Bold" FontSize="11"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
