<Window x:Class="IPAStudio.App.Views.SupportAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удалённая поддержка" Width="980" Height="680"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Background}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Панель администратора" Style="{StaticResource Text.Title}" />
            <TextBlock Text="Ключ импортирован только для этого входа и не сохраняется приложением."
                       Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,16">
            <Border x:Name="LoginPanel" Style="{StaticResource Card}" MaxWidth="440" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Пароль администратора" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                    <PasswordBox x:Name="AdminPassword" Margin="0,10,0,14" Padding="10" />
                    <Button Content="Войти" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Click="Login_Click" />
                </StackPanel>
            </Border>

            <ListView x:Name="DevicesList" Visibility="Collapsed" Background="Transparent" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                            <Grid Width="850">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding Online}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Success}" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="18,5,0,0">
                                        <Run Text="Windows: " /><Run Text="{Binding WindowsVersion}" /><Run Text="  •  IPA Studio: " /><Run Text="{Binding AppVersion}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding LastSeenAt, StringFormat='Последняя связь: {0:g}'}" Style="{StaticResource Text.Caption}" Margin="18,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Подключиться" Style="{StaticResource Button.Primary}" Tag="{Binding}" Click="Connect_Click" Margin="0,0,8,0" />
                                    <Button Content="Скопировать пароль" Style="{StaticResource Button.Secondary}" Tag="{Binding}" Click="CopyPassword_Click" Margin="0,0,8,0" />
                                    <Button Content="Отозвать" Style="{StaticResource Button.Danger}" Tag="{Binding}" Click="Revoke_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="StatusText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
    </Grid>
</Window>
