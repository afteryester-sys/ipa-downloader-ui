<UserControl x:Class="IPAStudio.App.Views.OnDeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IPAStudio.App.Converters"
             xmlns:ctrl="clr-namespace:IPAStudio.App.Controls">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:InitialConverter x:Key="Initial" />

        <!-- ===== Picking an app =====
             Same ring-plus-badge language as the archive picker on the install-from-file
             page, so the two lists that let you tick several items agree on what "selected"
             looks like.

             In click mode the whole row or tile is the target: a tile is mostly artwork, and
             asking for a 16px box inside it is a worse gesture than clicking the thing itself.
             The tick is kept as a read-out - it shows what is chosen - but it is not what has
             to be hit. In checkbox mode a real box appears and the row stops responding.

             Drawn on the container rather than on a Button wrapped around the content, which is
             what this was. A Button handles the click itself, so the shared click-to-select
             behaviour - which has to leave buttons inside a tile alone - could never see it,
             and the row would both toggle and select from one press.

             Selection is drawn as a ring that grows into place rather than appearing instantly,
             so picking many apps in a row reads as a sequence of deliberate acts instead of a
             grid flickering between two states. The pop is deliberately small (0.98) and short:
             at a hundred tiles anything larger turns a sweep of selections into a jelly wobble. -->
        <Style x:Key="Selectable" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Pop" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>

                            <!-- Hover and selected fill share one layer; the ring sits above it
                                 so the accent edge is never dimmed by the tint underneath. -->
                            <Border x:Name="Fill" CornerRadius="12" Background="Transparent" />

                            <Border x:Name="Ring" CornerRadius="12" Opacity="0"
                                    BorderBrush="{StaticResource Brush.Accent}"
                                    BorderThickness="0" />

                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{StaticResource Brush.SurfaceHover}" />
                            </Trigger>

                            <!-- Keyboard focus has to be visible on its own: without this a
                                 tabbed-to tile would look identical to an untouched one. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Ring" Property="BorderThickness" Value="1.5" />
                            </Trigger>

                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{StaticResource Brush.AccentSoft}" />
                                <!-- The on state lives in these two setters; the storyboards only
                                     animate into and out of it and run with FillBehavior="Stop", so a
                                     finished animation never outranks the trigger and cannot leave a
                                     ring painted on a row whose flag has gone false. -->
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
                                <!-- HandoffBehavior is explicitly SnapshotAndReplace on both actions below.
                                     The default is Compose, which lets a still-running clock from whatever
                                     item this container last held keep holding Ring/Pop's local values
                                     after a virtualized ListBox recycles the container onto a new row (e.g.
                                     re-opening this page for a second device). Compose only guarantees the
                                     *last-started* animation wins, but a recycle can hand a container to a
                                     row whose IsSelected trigger doesn't change value (e.g. both the old and
                                     new row are unselected), so neither action re-fires and the previous
                                     row's half-finished exit animation is left to decide the paint -
                                     visually "selected" even though SelectedCount is correctly 0.
                                     SnapshotAndReplace makes each fresh trigger evaluation forcibly override
                                     whatever clock the recycled container inherited. -->
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                        <Storyboard FillBehavior="Stop">
                                            <ThicknessAnimation Storyboard.TargetName="Ring"
                                                Storyboard.TargetProperty="BorderThickness"
                                                To="2" Duration="0:0:0.18">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Ring"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1" Duration="0:0:0.14" />
                                            <DoubleAnimationUsingKeyFrames
                                                Storyboard.TargetName="Pop"
                                                Storyboard.TargetProperty="ScaleX">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.09" Value="0.98" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames
                                                Storyboard.TargetName="Pop"
                                                Storyboard.TargetProperty="ScaleY">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.09" Value="0.98" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                        <Storyboard FillBehavior="Stop">
                                            <ThicknessAnimation Storyboard.TargetName="Ring"
                                                Storyboard.TargetProperty="BorderThickness"
                                                To="0" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Ring"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>

                            <!-- An app that cannot be fetched right now is not offered as a
                                 target at all: no hand cursor, no hover, no ring. -->
                            <DataTrigger Binding="{Binding CanSelect}" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter TargetName="Fill" Property="Background" Value="Transparent" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same treatment, only spaced as a grid cell rather than as a row. -->
        <Style x:Key="SelectableTile" TargetType="ListBoxItem" BasedOn="{StaticResource Selectable}">
            <Setter Property="Margin" Value="5" />
        </Style>

        <!-- The tick that shows the outcome. Not a control any more: it cannot be clicked, so it
             never disagrees with the ring about what a click just did. -->
        <Style x:Key="SelectedBadge" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <!-- The scale lives on each badge (see the usages), not in a setter here.
                 WPF freezes a Freezable used as a style setter value and shares the one
                 instance across every item the style is applied to, and a frozen transform
                 cannot be animated: the storyboards below target "RenderTransform.ScaleX",
                 so the first selection threw XamlParseException ("cannot resolve all
                 property references in the property path") once per visible row. -->
            <Style.Triggers>
                <!-- Same reasoning as the Selectable style's Ring/Fill trigger above: this badge
                     is reused by a virtualized ListBox exactly like the row/tile it sits on, so
                     it needs SnapshotAndReplace on both actions or a recycled badge can keep
                     showing the previous row's checkmark after the page is reopened for the next
                     device. -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.14" />
                                <!-- Overshoots to 1.1 before settling: the badge is small, and a
                                     plain fade at this size is easy to miss entirely. -->
                                <DoubleAnimationUsingKeyFrames
                                    Storyboard.TargetProperty="RenderTransform.ScaleX">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.1" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1" />
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames
                                    Storyboard.TargetProperty="RenderTransform.ScaleY">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.1" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 To="0.6" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 To="0.6" Duration="0:0:0.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- List / tile toggle, matching the photo gallery's so the two screens are switched
             the same way. -->
        <Style x:Key="ViewToggle" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header. The left block's right margin leaves room for the account and
             Refresh controls beside it; those in turn keep 56px clear for the MainWindow
             gear button, which is drawn over the page. ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,200,0">
                <Button Content="{DynamicResource L.Back}" Style="{StaticResource Button.Back}"
                        Command="{Binding GoBackCommand}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <!-- Home sits next to Back so the whole path here can be left in one press. -->
                <Button Style="{StaticResource Button.Home}"
                        Command="{Binding GoHomeCommand}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.OnDevice.Title}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{Binding DeviceName}" Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,56,0">
                <TextBlock Text="{Binding AccountEmail}" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding AccountEmail, Converter={StaticResource NullToCollapsed}}" />
                <Button Content="{DynamicResource L.OnDevice.Refresh}" Style="{StaticResource Button.Ghost}"
                        Command="{Binding LoadCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" />
            </StackPanel>
        </Grid>

        <!-- ===== Sign-in notice: a copy can only be fetched with an Apple ID ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12"
                Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <Grid>
                <StackPanel Margin="0,0,140,0">
                    <TextBlock Text="{DynamicResource L.OnDevice.NeedLogin}"
                               Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource L.OnDevice.NeedLoginHint}"
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="{DynamicResource L.Devices.SignInPrompt}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource Button.Primary}" Command="{Binding SignInCommand}" />
            </Grid>
        </Border>

        <!-- ===== Toolbar: search + destination folder ===== -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="260" HorizontalAlignment="Left">
                <TextBox x:Name="SearchBox" Style="{StaticResource Input.TextBox}" Padding="14,12"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{DynamicResource L.Picker.SearchPlaceholder}" IsHitTestVisible="False"
                           Foreground="{StaticResource Brush.TextMuted}" FontSize="14"
                           Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,12,0">
                <TextBlock Text="{DynamicResource L.OnDevice.FolderLabel}" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding DestinationFolder}" Style="{StaticResource Text.Body}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding DestinationFolder, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Batch: tick rows, then fetch them in one run -->
                <Button Content="{Binding SelectAllLabel}" Style="{StaticResource Button.Ghost}"
                        Command="{Binding ToggleSelectAllCommand}" Margin="0,0,8,0"
                        IsEnabled="{Binding IsBatchRunning, Converter={StaticResource InverseBool}}" />
                <ToggleButton Style="{StaticResource Toggle.Filter}"
                              IsChecked="{Binding ShowSelectedOnly}" Margin="0,0,8,0"
                              Visibility="{Binding CanShowSelectedFilter, Converter={StaticResource BoolToVis}}" />
                <Button Content="{Binding DownloadSelectedLabel}" Style="{StaticResource Button.Primary}"
                        Command="{Binding DownloadSelectedCommand}" Margin="0,0,8,0"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"
                        IsEnabled="{Binding IsBatchRunning, Converter={StaticResource InverseBool}}" />
                <!-- Shown whenever rows are ticked. Gating it on a second device being attached
                     hid the feature entirely in the common one-phone case, with nothing to say
                     it existed; the menu explains an empty destination list instead. -->
                <Grid Margin="0,0,8,0"
                      Visibility="{Binding CanTransfer, Converter={StaticResource BoolToVis}}">

                    <Button x:Name="TransferToggle" Content="{Binding TransferSelectedLabel}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding ToggleTransferMenuCommand}"
                            IsEnabled="{Binding IsBatchRunning, Converter={StaticResource InverseBool}}" />

                    <!-- Placed in a Popup so the list floats over the app rows instead of
                         pushing the toolbar taller when it opens. -->
                    <Popup IsOpen="{Binding IsTransferMenuOpen}" PlacementTarget="{Binding ElementName=TransferToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           HorizontalOffset="0" VerticalOffset="6">
                        <Border Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                CornerRadius="10" Padding="8" MinWidth="260" MaxWidth="360">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.OnDevice.TransferPickTarget}"
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Margin="6,2,6,8"
                                           Visibility="{Binding HasTransferTargets, Converter={StaticResource BoolToVis}}" />

                                <ItemsControl ItemsSource="{Binding TransferTargets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button HorizontalContentAlignment="Left"
                                                    Style="{StaticResource Button.Ghost}"
                                                    Padding="10,8" Margin="0,1"
                                                    Command="{Binding DataContext.TransferSelectedCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                                                        <Run Text="{Binding Model, Mode=OneWay}" />
                                                        <Run Text="  ·  iOS " />
                                                        <Run Text="{Binding OsVersion, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Without this the menu would open as an empty box whenever
                                     only one phone is connected. -->
                                <TextBlock Text="{DynamicResource L.OnDevice.TransferNoTargets}"
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Margin="6,2,6,2"
                                           Visibility="{Binding NoTransferTargets, Converter={StaticResource BoolToVis}}" />

                                <!-- The apps are re-fetched from the store, not copied off this
                                     phone; saying so up front prevents the queue's download
                                     step from looking like a bug. -->
                                <TextBlock Text="{DynamicResource L.OnDevice.TransferHint}"
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Margin="6,8,6,2" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Button Content="{DynamicResource L.OnDevice.ChooseFolder}"
                        Style="{StaticResource Button.Secondary}" Command="{Binding BrowseFolderCommand}" />

                <!-- Leaves the downloads running and goes back. Only appears while there is
                     something to background, so it never sits there as a dead control. -->
                <Button Content="{DynamicResource L.Ops.Minimize}" Style="{StaticResource Button.Ghost}"
                        Command="{Binding MinimizeCommand}" Margin="8,0,0,0"
                        Visibility="{Binding CanMinimize, Converter={StaticResource BoolToVis}}" />

                <!-- Tile size. Only meaningful in tile mode, so it is shown with it. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                            Visibility="{Binding IsTileView, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource L.OnDevice.TileSize}" Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider Width="110" VerticalAlignment="Center"
                            Minimum="104" Maximum="208" TickFrequency="26" IsSnapToTickEnabled="True"
                            Value="{Binding TileSize}" />
                </StackPanel>

                <!-- Turns clicks on the list into picking apps out. Only shown in click mode;
                     with tick boxes the boxes are already the visible way in. -->
                <ToggleButton Style="{StaticResource Toggle.Pill}" Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Content="{DynamicResource L.Common.Select}"
                              ToolTip="{DynamicResource L.Common.Select.Hint}"
                              IsChecked="{Binding IsSelecting}"
                              Visibility="{Binding ShowSelectToggle, Converter={StaticResource BoolToVis}}" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Style="{StaticResource ViewToggle}" ToolTip="{DynamicResource L.OnDevice.ViewList}"
                            Content="&#xE8FD;" Command="{Binding SetListViewCommand}" />
                    <Button Style="{StaticResource ViewToggle}" ToolTip="{DynamicResource L.OnDevice.ViewTiles}"
                            Content="&#xF0E2;" Command="{Binding SetTileViewCommand}" Margin="4,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Batch progress line: without it a long run looks like nothing is happening -->
        <TextBlock Grid.Row="2" Text="{Binding BatchStatus}" Style="{StaticResource Text.Caption}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-12"
                   Visibility="{Binding BatchStatus, Converter={StaticResource NullToCollapsed}}" />

        <!-- ===== App list ===== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <!-- Loading -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Style="{StaticResource Progress.Slim}" IsIndeterminate="True" Width="180" />
                    <TextBlock Text="{DynamicResource L.OnDevice.Loading}" Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>

                <!-- Failure: never shown as an empty device -->
                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap"
                           VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                           TextAlignment="Center"
                           Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />

                <TextBlock Text="{DynamicResource L.OnDevice.Empty}" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                <ListBox ItemsSource="{Binding VisibleApps}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                         ctrl:TileSelection.Mode="{Binding SelectionMode}"
                         ctrl:TileSelection.IsSelecting="{Binding IsSelecting}"
                         ctrl:TileSelection.CtrlSelects="{Binding CtrlSelects}"
                         ItemContainerStyle="{StaticResource Selectable}"
                         Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- The badge and the box share this cell because only one of
                                     them is ever shown: the badge reads out a click-mode
                                     selection, the box is the control in checkbox mode. Fixed
                                     width so the column does not change size switching between
                                     the two modes. -->
                                <Grid Grid.Column="0" Width="20" Margin="2,0,10,0" VerticalAlignment="Center">
                                    <Border Style="{StaticResource SelectedBadge}"
                                            Visibility="{Binding DataContext.ShowSelectionCheckboxes,
                                                         RelativeSource={RelativeSource AncestorType=ListBox},
                                                         Converter={StaticResource BoolToVis},
                                                         ConverterParameter=invert}">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Border.RenderTransform>
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Surface}" />
                                    </Border>

                                    <!-- The box appears only where a download is actually
                                         possible, so a tick can never select an app the App
                                         Store would refuse, and only in checkbox mode, since in
                                         click mode the ring above already says what is selected. -->
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center" IsEnabled="{Binding IsIdle}">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding CanDownload}" Value="True" />
                                                            <Condition Binding="{Binding DataContext.ShowSelectionCheckboxes,
                                                                                 RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                       Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                </Grid>

                                <!-- The home-screen icon, with the app's initial showing
                                     through until SpringBoard hands the artwork over and for
                                     the apps it has none for. Clipped to a rounded square so
                                     it reads the way it does on the phone. -->
                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="9"
                                        Background="{StaticResource Brush.SurfaceHover}" Margin="0,0,14,0">
                                    <Grid>
                                        <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.TextMuted}" />
                                        <Border CornerRadius="9" Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Caption}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />

                                    <!-- Why the button is missing, in place of it -->
                                    <TextBlock Text="{Binding BlockedReason}" Style="{StaticResource Text.Caption}"
                                               Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding BlockedReason, Converter={StaticResource NullToCollapsed}}" />

                                    <!-- The device withheld the purchase account: say so rather than imply a match -->
                                    <TextBlock Text="{DynamicResource L.OnDevice.AccountUnverified}"
                                               Style="{StaticResource Text.Caption}"
                                               Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding IsAccountUnverified, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Caption}"
                                               Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />

                                    <!-- Catalog apps whose name resembles this one, offered after
                                         the store refuses the device's bundle id. Each carries
                                         its own store id, which is the only identifier that
                                         still works for an app pulled from sale. The store id is
                                         shown because several of these names differ only by a
                                         suffix. -->
                                    <ItemsControl ItemsSource="{Binding Candidates}" Margin="0,6,0,0"
                                                  Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Button.Ghost}"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="8,5" Margin="0,0,0,3"
                                                        Command="{Binding Command}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" />
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Caption}"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Progress while saving -->
                                    <Grid Margin="0,8,0,0"
                                          Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                        <ProgressBar Style="{StaticResource Progress.Slim}" Height="4"
                                                     Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                                     IsIndeterminate="{Binding IsProgressIndeterminate}" />
                                    </Grid>

                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="14,0,0,0">
                                    <!-- Style set only through the trigger below: setting the
                                         attribute as well would assign Style twice. -->
                                    <Button Content="{DynamicResource L.OnDevice.Download}" Padding="14,8"
                                            Command="{Binding DataContext.DownloadCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding CanDownload}" Value="True" />
                                                            <Condition Binding="{Binding IsIdle}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="{DynamicResource L.Cancel}" Style="{StaticResource Button.Ghost}"
                                            Padding="14,8"
                                            Command="{Binding DataContext.CancelCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />

                                    <Button Content="{DynamicResource L.OnDevice.Reveal}"
                                            Style="{StaticResource Button.Ghost}" Padding="14,8" Margin="6,0,0,0"
                                            Command="{Binding DataContext.OpenSavedFolderCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding SavedPath, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ===== Tile mode =====
                     The same apps as a grid of home-screen icons, which is how they are
                     recognised on the phone: at a glance the artwork is faster to find than a
                     name in a column of rows.

                     Sizes come from the view model rather than being written here, because the
                     panel needs the tile's outer height as a number - it lays out a uniform grid
                     and cannot ask a template how tall it will turn out. -->
                <ListBox ItemsSource="{Binding VisibleApps}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                         ctrl:TileSelection.Mode="{Binding SelectionMode}"
                         ctrl:TileSelection.IsSelecting="{Binding IsSelecting}"
                         ctrl:TileSelection.CtrlSelects="{Binding CtrlSelects}"
                         ItemContainerStyle="{StaticResource SelectableTile}"
                         Visibility="{Binding IsTileView, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- TileSize is bound so the panel drops its cached measurement when
                                 the slider moves; without it the grid would keep the old spacing. -->
                            <ctrl:VirtualizingWrapPanel TileSize="{Binding DataContext.TileSize,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="{Binding DataContext.TileSize,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Height="{Binding DataContext.TileHeight,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Margin="6,8,6,6">
                                <Grid HorizontalAlignment="Center">
                                    <!-- The artwork, with the app's initial showing through until
                                         SpringBoard hands it over, as in list mode. -->
                                    <Border Width="{Binding DataContext.TileIconSize,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Height="{Binding DataContext.TileIconSize,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CornerRadius="{Binding DataContext.TileIconRadius,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Background="{StaticResource Brush.SurfaceHover}">
                                        <Grid>
                                            <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="24" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.TextMuted}" />
                                            <Border CornerRadius="{Binding DataContext.TileIconRadius,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Sits on the icon's corner rather than beside it: a leading
                                         column would cost a tile most of its width. Hidden in
                                         checkbox mode, where the box below takes the same corner. -->
                                    <Border Style="{StaticResource SelectedBadge}"
                                            Margin="0,-3,-5,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Visibility="{Binding DataContext.ShowSelectionCheckboxes,
                                                         RelativeSource={RelativeSource AncestorType=UserControl},
                                                         Converter={StaticResource BoolToVis},
                                                         ConverterParameter=invert}">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Border.RenderTransform>
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Surface}" />
                                    </Border>

                                    <!-- Over the icon's corner rather than beside it: the row
                                         layout's leading column would cost a tile most of its
                                         width. Backed so it stays visible on light artwork. -->
                                    <Border CornerRadius="6" Padding="2" Margin="0,-2,-4,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="{StaticResource Brush.Surface}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding CanDownload}" Value="True" />
                                                            <Condition Binding="{Binding DataContext.ShowSelectionCheckboxes,
                                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsIdle}" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}"
                                           FontWeight="SemiBold" TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Caption}"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <!-- Progress and status only; the reasons an app cannot be
                                     fetched are long prose that no tile has room for, so tile
                                     mode leaves those to the list. -->
                                <ProgressBar Style="{StaticResource Progress.Slim}" Height="4" Margin="0,8,0,0"
                                             Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                                             Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                           Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />

                                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Caption}"
                                           Foreground="{StaticResource Brush.Danger}" TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                           Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />

                                <Button Content="{DynamicResource L.OnDevice.Download}" Padding="10,6" Margin="0,8,0,0"
                                        Command="{Binding DataContext.DownloadCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding CanDownload}" Value="True" />
                                                        <Condition Binding="{Binding IsIdle}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="{DynamicResource L.Cancel}" Style="{StaticResource Button.Ghost}"
                                        Padding="10,6" Margin="0,8,0,0"
                                        Command="{Binding DataContext.CancelCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />

                                <Button Content="{DynamicResource L.OnDevice.Reveal}" Style="{StaticResource Button.Ghost}"
                                        Padding="10,6" Margin="0,8,0,0"
                                        Command="{Binding DataContext.OpenSavedFolderCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding SavedPath, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
