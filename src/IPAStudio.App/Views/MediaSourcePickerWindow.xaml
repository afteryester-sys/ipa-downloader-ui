<Window x:Class="IPAStudio.App.Views.MediaSourcePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.MediaExport.PickSourceDialogTitle}"
        Width="580" Height="640" MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Device card style with hover and selection -->
        <Style x:Key="DeviceRowButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Devices List -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                    Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource L.MediaExport.PickSourceDialogTitle}"
                           Style="{StaticResource Text.Body}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource L.MediaExport.PickSourceDialogSubtitle}"
                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
            <StackPanel>

                <!-- Section 1: Android Phones -->
                <TextBlock Text="{DynamicResource L.MediaExport.Section.Phones}"
                           Style="{StaticResource Text.Body}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />

                <!-- Phone cards container -->
                <StackPanel x:Name="PhonesPanel" />

                <!-- Helper card when no phone is detected -->
                <Border x:Name="NoPhonesCard" Background="{DynamicResource Brush.SurfaceHover}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,12,0" VerticalAlignment="Top" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource L.MediaExport.NoPhoneFound}"
                                       Style="{StaticResource Text.Body}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{DynamicResource L.MediaExport.NoPhoneHint}"
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,10" LineHeight="18" />
                            <Button Content="{DynamicResource L.MediaExport.RefreshDevices}"
                                    Style="{StaticResource Button.Secondary}"
                                    HorizontalAlignment="Left" Padding="12,6" Click="OnRefreshClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 2: Drives and Storage -->
                <TextBlock Text="{DynamicResource L.MediaExport.Section.Drives}"
                           Style="{StaticResource Text.Body}" FontWeight="SemiBold" FontSize="13" Margin="0,6,0,8" />

                <StackPanel x:Name="DrivesPanel" />

                <!-- Section 3: Custom Folder -->
                <TextBlock Text="{DynamicResource L.MediaExport.BrowseFolder}"
                           Style="{StaticResource Text.Body}" FontWeight="SemiBold" FontSize="13" Margin="0,6,0,8" />

                <Button Style="{StaticResource DeviceRowButton}" Click="OnBrowseFolderClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                Background="{DynamicResource Brush.SurfaceHover}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource L.MediaExport.BrowseFolder}"
                                       Style="{StaticResource Text.Body}" FontWeight="SemiBold" FontSize="13.5" />
                            <TextBlock Text="{DynamicResource L.MediaExport.BrowseFolderHint}"
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="10,0,4,0" />
                    </Grid>
                </Button>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{DynamicResource L.MediaExport.RefreshDevices}"
                    Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                    Padding="10,6" Click="OnRefreshClick">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource L.MediaExport.RefreshDevices}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>

            <Button Grid.Column="1" Content="{DynamicResource L.Cancel}"
                    Style="{StaticResource Button.Secondary}" MinWidth="110"
                    IsCancel="True" Click="OnCancelClick" />
        </Grid>
    </Grid>
</Window>
