<UserControl x:Class="IPAStudio.App.Views.DirectDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IPAStudio.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:InitialConverter x:Key="Initial" />
    </UserControl.Resources>

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header. Back sits left of the title, as on every other page; the
             top-right corner belongs to the MainWindow gear button, which is drawn over
             the page and was covering Back here. ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,56,0">
                <Button Content="{DynamicResource L.Back}" Style="{StaticResource Button.Back}"
                        Command="{Binding GoBackCommand}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Direct.Title}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{DynamicResource L.Direct.Subtitle}"
                               Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">

                <!-- ===== Sign-in warning: the download is signed with the Apple ID ===== -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16"
                        Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <Grid>
                        <StackPanel Margin="0,0,140,0">
                            <TextBlock Text="{DynamicResource L.Direct.NeedLogin}"
                                       Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource L.Direct.NeedLoginHint}"
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Content="{DynamicResource L.Devices.SignInPrompt}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding SignInCommand}" />
                    </Grid>
                </Border>

                <!-- ===== Step 1: Bundle ID ===== -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Direct.BundleIdLabel}"
                                   Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource L.Direct.BundleIdHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Margin="0,2,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{StaticResource Input.TextBox}"
                                     Text="{Binding BundleId, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}"
                                     VerticalAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding LookupCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <Button Grid.Column="1" Content="{DynamicResource L.Direct.Find}"
                                    Style="{StaticResource Button.Secondary}" Margin="10,0,0,0"
                                    Command="{Binding LookupCommand}"
                                    IsEnabled="{Binding IsLookingUp, Converter={StaticResource InverseBool}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Resolved app card ===== -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"
                        Visibility="{Binding FoundApp, Converter={StaticResource NullToCollapsed}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="14" Margin="0,0,16,0"
                                Background="{StaticResource Brush.SurfaceHover}">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14" />
                            </Border.Clip>
                            <Grid>
                                <!-- The initial shows through until artwork arrives, and stays
                                     for apps no source has any for. -->
                                <TextBlock Text="{Binding FoundApp.Name, Converter={StaticResource Initial}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextMuted}" />
                                <Image Source="{Binding FoundIconUrl}" Stretch="UniformToFill" />
                                <!-- Read off a connected device, for apps with no store
                                     artwork URL. Drawn last so it wins when both exist. -->
                                <Image Source="{Binding FoundIconImage}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FoundApp.Name}" Style="{StaticResource Text.Body}"
                                       FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FoundApp.Developer}"
                                       Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                            <!-- Joined in the view model so the separator cannot outlive the
                                 values it separates: an unlisted app has neither, and this
                                 line was rendering as a single stray "·" under the name. -->
                            <TextBlock Text="{Binding FoundDetails}"
                                       Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding FoundDetails, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>

                        <!-- Add to catalog, or a note that it is already there -->
                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="{DynamicResource L.Direct.AddToCatalog}"
                                    Style="{StaticResource Button.Ghost}"
                                    Padding="14,8"
                                    Command="{Binding AddToCatalogCommand}"
                                    ToolTip="{DynamicResource L.Direct.AddToCatalogHint}"
                                    Visibility="{Binding CanAddToCatalog, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{DynamicResource L.Direct.InCatalog}"
                                       Style="{StaticResource Text.Caption}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsInCatalog, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- ===== Step 2: destination folder ===== -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Direct.FolderLabel}"
                                   Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource L.Direct.FolderHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Margin="0,2,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{StaticResource Input.TextBox}"
                                     Text="{Binding DestinationFolder}"
                                     IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}"
                                     VerticalAlignment="Center" />

                            <Button Grid.Column="1" Content="{DynamicResource L.Direct.Browse}"
                                    Style="{StaticResource Button.Secondary}" Margin="10,0,0,0"
                                    Command="{Binding BrowseFolderCommand}"
                                    IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Action row ===== -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="{DynamicResource L.Direct.Download}"
                            Style="{StaticResource Button.Primary}" MinWidth="180"
                            Command="{Binding DownloadCommand}"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                    <Button Content="{DynamicResource L.Direct.Cancel}"
                            Style="{StaticResource Button.Danger}" MinWidth="180"
                            Command="{Binding CancelDownloadCommand}"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />

                    <Button Content="{DynamicResource L.Direct.OpenFolder}"
                            Style="{StaticResource Button.Secondary}" Margin="10,0,0,0"
                            Command="{Binding OpenFolderCommand}"
                            Visibility="{Binding SavedPath, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>

                <!-- ===== Progress + status ===== -->
                <StackPanel Margin="0,0,0,12"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Style="{StaticResource Progress.Slim}" Minimum="0" Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />

                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Caption}"
                           Foreground="{StaticResource Brush.Danger}"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
