<UserControl x:Class="IPAStudio.App.Views.DirectDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IPAStudio.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:InitialConverter x:Key="Initial" />
    </UserControl.Resources>

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header. Back sits left of the title, as on every other page; the
             top-right corner belongs to the MainWindow gear button, which is drawn over
             the page and was covering Back here. ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,56,0">
                <Button Content="{DynamicResource L.Back}" Style="{StaticResource Button.Back}"
                        Command="{Binding GoBackCommand}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <!-- Home sits next to Back so the whole path here can be left in one press. -->
                <Button Style="{StaticResource Button.Home}"
                        Command="{Binding GoHomeCommand}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Direct.Title}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{DynamicResource L.Direct.Subtitle}"
                               Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="960" HorizontalAlignment="Left">

                <!-- ===== Sign-in warning: the download is signed with the Apple ID ===== -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16"
                        Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <Grid>
                        <StackPanel Margin="0,0,140,0">
                            <TextBlock Text="{DynamicResource L.Direct.NeedLogin}"
                                       Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource L.Direct.NeedLoginHint}"
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Content="{DynamicResource L.Devices.SignInPrompt}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding SignInCommand}" />
                    </Grid>
                </Border>

                <!-- ===== Step 1: Bundle ID ===== -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Direct.BundleIdLabel}"
                                   Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource L.Direct.BundleIdHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Margin="0,2,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{StaticResource Input.TextBox}"
                                     Text="{Binding BundleId, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsActionInProgress, Converter={StaticResource InverseBool}}"
                                     VerticalAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding LookupCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <Button Grid.Column="1" Content="{DynamicResource L.Direct.Find}"
                                    Style="{StaticResource Button.Secondary}" Margin="10,0,0,0"
                                    Command="{Binding LookupCommand}"
                                    IsEnabled="{Binding IsLookingUp, Converter={StaticResource InverseBool}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Resolved app card ===== -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"
                        Visibility="{Binding FoundApp, Converter={StaticResource NullToCollapsed}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="14" Margin="0,0,16,0"
                                Background="{StaticResource Brush.SurfaceHover}">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14" />
                            </Border.Clip>
                            <Grid>
                                <!-- The initial shows through until artwork arrives, and stays
                                     for apps no source has any for. -->
                                <TextBlock Text="{Binding FoundApp.Name, Converter={StaticResource Initial}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextMuted}" />
                                <Image Source="{Binding FoundIconUrl}" Stretch="UniformToFill" />
                                <!-- Read off a connected device, for apps with no store
                                     artwork URL. Drawn last so it wins when both exist. -->
                                <Image Source="{Binding FoundIconImage}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FoundApp.Name}" Style="{StaticResource Text.Body}"
                                       FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FoundApp.Developer}"
                                       Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                            <!-- Joined in the view model so the separator cannot outlive the
                                 values it separates: an unlisted app has neither, and this
                                 line was rendering as a single stray "·" under the name. -->
                            <TextBlock Text="{Binding FoundDetails}"
                                       Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding FoundDetails, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>

                        <!-- Rename the output file, or add to catalog / note it is already there -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                    HorizontalAlignment="Right">
                            <!-- Convenient rename right where the found app's name is shown,
                                 instead of hunting for it in a separate step. -->
                            <Button Content="{DynamicResource L.Catalogs.Rename}"
                                    Style="{StaticResource Button.Ghost}"
                                    Padding="14,8" Margin="0,0,0,6"
                                    Command="{Binding StartRenameCommand}"
                                    ToolTip="{DynamicResource L.Direct.FileNameHint}" />
                            <Grid>
                                <Button Content="{DynamicResource L.Direct.AddToCatalog}"
                                        Style="{StaticResource Button.Ghost}"
                                        Padding="14,8"
                                        Command="{Binding AddToCatalogCommand}"
                                        ToolTip="{DynamicResource L.Direct.AddToCatalogHint}"
                                        Visibility="{Binding CanAddToCatalog, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{DynamicResource L.Direct.InCatalog}"
                                           Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsInCatalog, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Rename panel: edited in place, right under the app it renames, rather than
                     as a modal dialog which would be the only one of its kind in the app. -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16"
                        Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Direct.FileNameLabel}"
                                   Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                        <TextBox Style="{StaticResource Input.TextBox}" Margin="0,8,0,0"
                                 Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CommitRenameCommand}" />
                                <KeyBinding Key="Esc" Command="{Binding CancelRenameCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding FileNameError}" Style="{StaticResource Text.Caption}"
                                   Foreground="{StaticResource Brush.Danger}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding FileNameError, Converter={StaticResource NullToCollapsed}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{DynamicResource L.Catalogs.Save}"
                                    Style="{StaticResource Button.Secondary}"
                                    Command="{Binding CommitRenameCommand}" Margin="0,0,6,0" />
                            <Button Content="{DynamicResource L.Cancel}" Style="{StaticResource Button.Ghost}"
                                    Command="{Binding CancelRenameCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Step 2: destination folder ===== -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Direct.FolderLabel}"
                                   Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource L.Direct.FolderHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Margin="0,2,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{StaticResource Input.TextBox}"
                                     Text="{Binding DestinationFolder}"
                                     IsEnabled="{Binding IsActionInProgress, Converter={StaticResource InverseBool}}"
                                     VerticalAlignment="Center" />

                            <Button Grid.Column="1" Content="{DynamicResource L.Direct.Browse}"
                                    Style="{StaticResource Button.Secondary}" Margin="10,0,0,0"
                                    Command="{Binding BrowseFolderCommand}"
                                    IsEnabled="{Binding IsActionInProgress, Converter={StaticResource InverseBool}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Action row ===== -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="{DynamicResource L.Direct.Download}"
                            Style="{StaticResource Button.Primary}" MinWidth="180" Margin="0,0,10,10"
                            Command="{Binding DownloadCommand}"
                            Visibility="{Binding IsActionInProgress, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                    <!-- Purchase (App Store license acquisition) button -->
                    <Button Style="{StaticResource Button.Secondary}" MinWidth="130" Margin="0,0,10,10"
                            Command="{Binding PurchaseCommand}"
                            Visibility="{Binding IsActionInProgress, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                            ToolTip="{DynamicResource L.Direct.PurchaseHint}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="{DynamicResource L.Direct.Purchase}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Content="{DynamicResource L.Direct.Cancel}"
                            Style="{StaticResource Button.Danger}" MinWidth="180" Margin="0,0,10,10"
                            Command="{Binding CancelDownloadCommand}"
                            Visibility="{Binding IsActionInProgress, Converter={StaticResource BoolToVis}}" />

                    <!-- The alternative route. Sits beside the main button rather than
                         replacing it: the normal path is still the faster one when it works,
                         and this one needs iTunes 12.6.5.3 plus a click inside iTunes. -->
                    <Button Content="{DynamicResource L.Itunes.Button}"
                            Style="{StaticResource Button.Secondary}" Margin="0,0,10,10"
                            ToolTip="{DynamicResource L.Itunes.ButtonHint}"
                            Command="{Binding DownloadViaItunesCommand}"
                            Visibility="{Binding IsActionInProgress, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                    <!-- Install to device button - toggles the target devices picker -->
                    <Button Style="{StaticResource Button.Primary}" Margin="0,0,10,10"
                            Command="{Binding ToggleDevicePickerCommand}"
                            Visibility="{Binding SavedPath, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource L.Direct.InstallToDevice}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Content="{DynamicResource L.Direct.OpenFolder}"
                            Style="{StaticResource Button.Secondary}" Margin="0,0,10,10"
                            Command="{Binding OpenFolderCommand}"
                            Visibility="{Binding SavedPath, Converter={StaticResource NullToCollapsed}}" />
                </WrapPanel>

                <!-- ===== Target Devices Picker (appears only after clicking Install to Device) ===== -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"
                        Visibility="{Binding IsDevicePickerOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource L.Direct.TargetDevice}"
                                           Style="{StaticResource Text.Body}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="{DynamicResource L.Direct.TargetDeviceHint}"
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Padding="6,4"
                                    VerticalAlignment="Top" Command="{Binding CloseDevicePickerCommand}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                        </Grid>

                        <!-- When no devices connected -->
                        <Border Background="{DynamicResource Brush.SurfaceHover}"
                                CornerRadius="10" Padding="14,12" Margin="0,0,0,14"
                                Visibility="{Binding HasConnectedDevices, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource L.Direct.NoDevices}"
                                           Style="{StaticResource Text.Caption}"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Connected devices cards with signature tactile click & selection animation -->
                        <ItemsControl ItemsSource="{Binding TargetDevices}"
                                      Visibility="{Binding HasConnectedDevices, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ToggleDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,12,12" MinWidth="220" MaxWidth="280"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform x:Name="Pop" ScaleX="1" ScaleY="1" />
                                                    </Grid.RenderTransform>

                                                    <Border x:Name="Fill" CornerRadius="12"
                                                            Background="{DynamicResource Brush.Surface}" />

                                                    <Border x:Name="Ring" CornerRadius="12" Opacity="0"
                                                            BorderBrush="{DynamicResource Brush.Accent}"
                                                            BorderThickness="0" />

                                                    <Grid Margin="14,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Device badge -->
                                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                                                Background="{DynamicResource Brush.SurfaceHover}"
                                                                VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <Border Width="14" Height="22" CornerRadius="3"
                                                                    BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1.5"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Border Width="6" Height="1.5" CornerRadius="0.5"
                                                                        Background="{DynamicResource Brush.Accent}"
                                                                        VerticalAlignment="Top" Margin="0,2,0,0" />
                                                            </Border>
                                                        </Border>

                                                        <!-- Device Info -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Style="{StaticResource Text.Caption}" FontSize="11" Margin="0,2,0,0">
                                                                <Run Text="{Binding Model, Mode=OneWay}" />
                                                                <Run Text=" · iOS " />
                                                                <Run Text="{Binding OsVersion, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- Selection check indicator -->
                                                        <Border Grid.Column="2" Width="20" Height="20" CornerRadius="10"
                                                                VerticalAlignment="Center" Margin="8,0,0,0"
                                                                Background="{DynamicResource Brush.SurfaceHover}"
                                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Grid>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Fill" Property="Background"
                                                                Value="{DynamicResource Brush.SurfaceHover}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Fill" Property="Background"
                                                                Value="{DynamicResource Brush.AccentSoft}" />
                                                        <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                        <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                                <Storyboard FillBehavior="Stop">
                                                                    <ThicknessAnimation Storyboard.TargetName="Ring"
                                                                        Storyboard.TargetProperty="BorderThickness"
                                                                        To="2" Duration="0:0:0.18">
                                                                        <ThicknessAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut" />
                                                                        </ThicknessAnimation.EasingFunction>
                                                                    </ThicknessAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Ring"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="1" Duration="0:0:0.14" />
                                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pop"
                                                                        Storyboard.TargetProperty="ScaleX">
                                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.09" Value="0.97" />
                                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                                                                    </DoubleAnimationUsingKeyFrames>
                                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pop"
                                                                        Storyboard.TargetProperty="ScaleY">
                                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.09" Value="0.97" />
                                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                                                                    </DoubleAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                                <Storyboard FillBehavior="Stop">
                                                                    <ThicknessAnimation Storyboard.TargetName="Ring"
                                                                        Storyboard.TargetProperty="BorderThickness"
                                                                        To="0" Duration="0:0:0.12" />
                                                                    <DoubleAnimation Storyboard.TargetName="Ring"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0" Duration="0:0:0.12" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Actions inside device picker -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource Button.Primary}" MinWidth="180" Margin="0,0,10,0"
                                    Command="{Binding InstallToDeviceCommand}"
                                    IsEnabled="{Binding CanInstallToDevice}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource L.Direct.InstallSelected}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Content="{DynamicResource L.Cancel}"
                                    Style="{StaticResource Button.Ghost}"
                                    Command="{Binding CloseDevicePickerCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Why the iTunes route is refusing, or what it is waiting for. Kept out of
                     ErrorText so a missing iTunes does not look like a failed download. -->
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16"
                        Visibility="{Binding ItunesHint, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding ItunesHint}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16"
                        Visibility="{Binding IsItunesRunning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource L.Itunes.Instructions}"
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                </Border>

                <!-- ===== Progress + status ===== -->
                <StackPanel Margin="0,0,0,12"
                            Visibility="{Binding IsActionInProgress, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Style="{StaticResource Progress.Slim}" Minimum="0" Maximum="100"
                                 Value="{Binding ActiveProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />

                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Caption}"
                           Foreground="{StaticResource Brush.Danger}"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
