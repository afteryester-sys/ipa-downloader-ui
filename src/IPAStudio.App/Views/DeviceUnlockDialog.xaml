<Window x:Class="IPAStudio.App.Views.DeviceUnlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.Guard.Title}"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}">

    <StackPanel Margin="22">

        <TextBlock Text="{DynamicResource L.Guard.Title}"
                   Style="{StaticResource Text.Body}"
                   FontSize="17" FontWeight="SemiBold" />

        <!-- Names the device and the action, because a password prompt that says only
             "enter the password" gives no way to tell an expected one from a stray click. -->
        <TextBlock x:Name="ActionLine"
                   Style="{StaticResource Text.Body}"
                   TextWrapping="Wrap" Margin="0,10,0,0" />

        <Border CornerRadius="10" Padding="14"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                Margin="0,14,0,0">
            <StackPanel>
                <TextBlock x:Name="DeviceLine"
                           Style="{StaticResource Text.Body}"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SerialLine"
                           Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- PasswordBox rather than a TextBox: this dialog opens over a shared screen, often
             with someone watching the install run. -->
        <PasswordBox x:Name="PasswordInput"
                     Margin="0,16,0,0"
                     Padding="10,8"
                     FontSize="14"
                     Background="{StaticResource Brush.Surface}"
                     Foreground="{StaticResource Brush.Text}"
                     BorderBrush="{StaticResource Brush.Border}"
                     BorderThickness="1"
                     KeyDown="OnPasswordKeyDown" />

        <!-- Collapsed until an attempt fails, so the dialog does not open already accusing. -->
        <TextBlock x:Name="ErrorLine"
                   Style="{StaticResource Text.Caption}"
                   Foreground="{StaticResource Brush.Danger}"
                   Text="{DynamicResource L.Guard.Wrong}"
                   Visibility="Collapsed"
                   TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{DynamicResource L.Cancel}"
                    Style="{StaticResource Button.Ghost}"
                    MinWidth="110" Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancel" />
            <Button Content="{DynamicResource L.Guard.Confirm}"
                    Style="{StaticResource Button.Primary}"
                    MinWidth="140"
                    IsDefault="True"
                    Click="OnConfirm" />
        </StackPanel>
    </StackPanel>
</Window>
