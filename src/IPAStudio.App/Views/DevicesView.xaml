<UserControl x:Class="IPAStudio.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IPAStudio.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BatteryToBrushConverter x:Key="BatteryBrush" />
        <!-- Declared here rather than relying on MainWindow's copy: this view is also
             loaded on its own, and a StaticResource must resolve within this file. -->
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </UserControl.Resources>

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <!-- Titles (leave 200px on the right for the action buttons) -->
            <StackPanel Margin="0,0,200,0">
                <TextBlock Text="{DynamicResource L.Devices.Title}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{DynamicResource L.Devices.Subtitle}"
                           Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Right-hand action row: account + sign-in/out only.
                 The settings/update button lives in MainWindow and must NOT
                 be duplicated here to avoid overlap. The 56px right margin keeps this row
                 clear of that gear, which is drawn over the page. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,56,0">
                <TextBlock Text="{Binding AccountEmail}" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />
                <Button Content="{DynamicResource L.Devices.SignOut}"
                        Style="{StaticResource Button.Ghost}"
                        Command="{Binding SignOutCommand}"
                        Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />
                <Button Content="{DynamicResource L.Devices.SignInPrompt}"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding SignInCommand}"
                        Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
            </StackPanel>
        </Grid>

        <!-- ===== Catalog status bar ===== -->
        <Border Grid.Row="1" Margin="0,0,0,20" Padding="14,10"
                CornerRadius="8" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L.Devices.Catalog}"
                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CatalogCount}"
                               Foreground="{StaticResource Brush.Accent}"
                               FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBlock Text="{DynamicResource L.Devices.CatalogApps}"
                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Loading progress (right-aligned) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding IsCatalogLoading, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Style="{StaticResource Progress.Slim}" Width="120"
                                 Value="{Binding CatalogLoadProgress, Mode=OneWay}" Maximum="100"
                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{DynamicResource L.Loading}"
                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Devices area (full width) ===== -->
        <Grid Grid.Row="2">

            <!-- Empty state: animated "waiting for iPhone" -->
            <Border Style="{StaticResource Card}" Padding="48"
                    Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="160" Height="160" Margin="0,0,0,24">
                        <Ellipse x:Name="PulseRing1" Width="120" Height="120"
                                 Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.5" Opacity="0" />
                        <Ellipse x:Name="PulseRing2" Width="120" Height="120"
                                 Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.5" Opacity="0" />
                        <Border Width="52" Height="96" CornerRadius="10"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Accent}" BorderThickness="2">
                            <Border Width="18" Height="4" CornerRadius="2"
                                    Background="{StaticResource Brush.Accent}"
                                    VerticalAlignment="Top" Margin="0,8,0,0" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{DynamicResource L.Devices.Empty}" Style="{StaticResource Text.Body}"
                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource L.Devices.EmptyHint}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Connected device cards -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="300" Margin="0,0,16,16"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                 From="0.92" To="1" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                 From="0.92" To="1" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>

                                <Grid>
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <!-- The device, drawn as a phone: a body in the card's own
                                             colours with this phone's wallpaper as its screen. The
                                             wallpaper is what tells two devices of the same model apart,
                                             which a generic outline icon could never do.

                                             Deliberately the wallpaper alone. A mosaic of real app icons
                                             used to be laid over it, and at eight pixels a square they
                                             read as a smear of colour rather than as a home screen - the
                                             frame looked broken instead of recognisable, and it cost a
                                             SpringBoard round-trip per icon on every connect. The
                                             wallpaper carries the same "this is my phone" signal on its
                                             own, for one request.

                                             Not a screen capture - that needs the Developer Disk Image
                                             mounted per iOS version and fails on a locked phone, whereas
                                             the wallpaper comes from SpringBoard, which any paired
                                             device answers. -->
                                        <Border Width="46" Height="76" CornerRadius="11" Padding="3"
                                                Background="{StaticResource Brush.SurfaceHover}"
                                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                                HorizontalAlignment="Left">
                                            <!-- The screen, inset so the body around it reads as a bezel. -->
                                            <Border CornerRadius="8" ClipToBounds="True"
                                                    Background="{StaticResource Brush.AccentSoft}">
                                                <Grid>
                                                    <!-- Fallback outline, covered once the wallpaper loads. -->
                                                    <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                               Foreground="{StaticResource Brush.Accent}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                    <Border Visibility="{Binding Wallpaper, Converter={StaticResource NullToCollapsed}}">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding Wallpaper}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>

                                                    <!-- Dynamic-island pill: the one detail that makes the
                                                         shape read as a phone and not a rounded box. -->
                                                    <Border Width="14" Height="4" CornerRadius="2" Margin="0,3,0,0"
                                                            Background="{StaticResource Brush.Text}" Opacity="0.5"
                                                            HorizontalAlignment="Center" VerticalAlignment="Top" />
                                                </Grid>
                                            </Border>
                                        </Border>
                                        <!-- Connection state and transport, side by side in one row so the
                                             two badges cannot overlap as either label changes length between
                                             languages. -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <!-- Transport: which of the two is shown is driven by IsNetworkLink,
                                                 so a device unplugged while on Wi-Fi updates in place. -->
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.AccentSoft}"
                                                    Margin="0,0,6,0"
                                                    ToolTip="{DynamicResource L.Devices.Link.Wifi}"
                                                    Visibility="{Binding IsNetworkLink, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               Foreground="{StaticResource Brush.Accent}"
                                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock Text="{DynamicResource L.Devices.Link.Wifi}"
                                                               Foreground="{StaticResource Brush.Accent}" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.AccentSoft}"
                                                    Margin="0,0,6,0"
                                                    ToolTip="{DynamicResource L.Devices.Link.Usb}"
                                                    Visibility="{Binding IsNetworkLink, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE88E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               Foreground="{StaticResource Brush.Accent}"
                                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock Text="{DynamicResource L.Devices.Link.Usb}"
                                                               Foreground="{StaticResource Brush.Accent}" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.SuccessSoft}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Success}"
                                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{DynamicResource L.Devices.Connected}"
                                                               Foreground="{StaticResource Brush.Success}" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}"
                                               FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                                        <Run Text="{Binding Model, Mode=OneWay}" /> · iOS <Run Text="{Binding OsVersion, Mode=OneWay}" />
                                    </TextBlock>

                                    <!-- Why the home screen preview is missing, stated on the card. Without
                                         it a failed fetch looks exactly like a device with a plain
                                         wallpaper, and the difference could only be found in the log. -->
                                    <TextBlock Text="{Binding PreviewNote}"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="0,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding HasPreviewNote, Converter={StaticResource BoolToVis}}" />

                                    <!-- Battery -->
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource L.Devices.Battery}"
                                                   Style="{StaticResource Text.Caption}" Margin="0,0,10,0" />
                                        <ProgressBar Grid.Column="1" Style="{StaticResource Progress.Slim}"
                                                     Value="{Binding BatteryLevel, Mode=OneWay}" Maximum="100"
                                                     Foreground="{Binding BatteryLevel, Converter={StaticResource BatteryBrush}}"
                                                     VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Margin="10,0,0,0">
                                            <Run Text="{Binding BatteryLevel, Mode=OneWay}" />%
                                        </TextBlock>
                                    </Grid>

                                    <!-- Primary action -->
                                    <Button Content="{DynamicResource L.Devices.Select}"
                                            Style="{StaticResource Button.Primary}" Margin="0,16,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <!-- Secondary actions -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="{DynamicResource L.Devices.Info}"
                                                Style="{StaticResource Button.Secondary}"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.OpenDeviceInfoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="2" Content="{DynamicResource L.Devices.Photos}"
                                                Style="{StaticResource Button.Secondary}"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.OpenPhotosCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>

                                    <!-- What is already installed here, as opposed to the catalog -->
                                    <Button Content="{DynamicResource L.OnDevice.Open}"
                                            Style="{StaticResource Button.Ghost}" Margin="0,8,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.OpenOnDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
