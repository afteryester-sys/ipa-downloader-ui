<UserControl x:Class="IPAStudio.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IPAStudio.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BatteryToBrushConverter x:Key="BatteryBrush" />
        <!-- Declared here rather than relying on MainWindow's copy: this view is also
             loaded on its own, and a StaticResource must resolve within this file. -->
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />

        <!-- Tool Card Button Style with smooth hover and press micro-animations -->
        <Style x:Key="ToolCardButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="10,6"
                                RenderTransformOrigin="0.5, 0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0" />
                            </Border.RenderTransform>
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.025" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.025" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.97" Duration="0:0:0.06">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.97" Duration="0:0:0.06">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.1">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.1">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <!-- Titles (leave 200px on the right for the action buttons) -->
            <StackPanel Margin="0,0,200,0">
                <TextBlock Text="{DynamicResource L.Devices.Title}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{DynamicResource L.Devices.Subtitle}"
                           Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Right-hand action row: account + sign-in/out only.
                 The settings/update button lives in MainWindow and must NOT
                 be duplicated here to avoid overlap. The 56px right margin keeps this row
                 clear of that gear, which is drawn over the page. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,56,0">
                <TextBlock Text="{Binding AccountEmail}" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />
                <Button Content="{DynamicResource L.Devices.SignOut}"
                        Style="{StaticResource Button.Ghost}"
                        Command="{Binding SignOutCommand}"
                        Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />
                <Button Content="{DynamicResource L.Devices.SignInPrompt}"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding SignInCommand}"
                        Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
            </StackPanel>
        </Grid>

        <!-- ===== Catalog status bar ===== -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="14,10"
                CornerRadius="8" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L.Devices.Catalog}"
                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CatalogCount}"
                               Foreground="{StaticResource Brush.Accent}"
                               FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBlock Text="{DynamicResource L.Devices.CatalogApps}"
                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Loading progress (right-aligned) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding IsCatalogLoading, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Style="{StaticResource Progress.Slim}" Width="120"
                                 Value="{Binding CatalogLoadProgress, Mode=OneWay}" Maximum="100"
                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{DynamicResource L.Loading}"
                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Tools Toolbar ===== -->
        <UniformGrid Grid.Row="2" Columns="5" Rows="1" Margin="-4,0,-4,20">
            <!-- 1. Download IPA -->
            <Button Style="{StaticResource ToolCardButton}" Command="{Binding OpenDirectDownloadCommand}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{DynamicResource L.Tools.DownloadIpa}"
                               Style="{StaticResource Text.Body}" FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" Margin="9,0,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>

            <!-- 2. Firmware -->
            <Button Style="{StaticResource ToolCardButton}" Command="{Binding OpenFirmwareCommand}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{DynamicResource L.Tools.Firmware}"
                               Style="{StaticResource Text.Body}" FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" Margin="9,0,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>

            <!-- 3. iCloud -->
            <Button Style="{StaticResource ToolCardButton}" Command="{Binding OpenICloudCommand}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{DynamicResource L.Tools.ICloud}"
                               Style="{StaticResource Text.Body}" FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" Margin="9,0,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>

            <!-- 4. Media Export -->
            <Button Style="{StaticResource ToolCardButton}" Command="{Binding OpenMediaExportCommand}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{DynamicResource L.Tools.MediaExport}"
                               Style="{StaticResource Text.Body}" FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" Margin="9,0,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>

            <!-- 5. Statistics -->
            <Button Style="{StaticResource ToolCardButton}" Command="{Binding OpenStatisticsCommand}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{DynamicResource L.Tools.Statistics}"
                               Style="{StaticResource Text.Body}" FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" Margin="9,0,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>
        </UniformGrid>

        <!-- ===== Devices area (full width) ===== -->
        <Grid Grid.Row="3">

            <!-- Empty state: animated "waiting for iPhone" -->
            <Border Style="{StaticResource Card}" Padding="48"
                    Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="160" Height="160" Margin="0,0,0,24">
                        <Ellipse x:Name="PulseRing1" Width="120" Height="120"
                                 Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.5" Opacity="0" />
                        <Ellipse x:Name="PulseRing2" Width="120" Height="120"
                                 Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.5" Opacity="0" />
                        <Border Width="52" Height="96" CornerRadius="10"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Accent}" BorderThickness="2">
                            <Border Width="18" Height="4" CornerRadius="2"
                                    Background="{StaticResource Brush.Accent}"
                                    VerticalAlignment="Top" Margin="0,8,0,0" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{DynamicResource L.Devices.Empty}" Style="{StaticResource Text.Body}"
                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource L.Devices.EmptyHint}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Connected device cards -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="300" Margin="0,0,16,16"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                 From="0.92" To="1" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                 From="0.92" To="1" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>

                                <Grid>
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <!-- The device as line art, shaped from what it reported about
                                             itself: a mini is narrower than a Max, a tablet is wider than
                                             both, and the notch, pill or home button says which era it is
                                             from. Geometry comes from DeviceOutlines, so the millimetre
                                             table is the single source for both the name and the drawing.

                                             This replaced a filled frame showing the phone's own wallpaper.
                                             The wallpaper did tell two identical models apart, but it cost
                                             a SpringBoard round-trip per device on every connect, came back
                                             empty on a locked phone often enough to need a "why not" note
                                             on the card, and put a photograph where the rest of the UI is
                                             flat single-colour iconography. One stroke in the theme's text
                                             colour sits with the toolbar glyphs instead.

                                             All shapes are drawn in one 64x88 box scaled by the Viewbox,
                                             which is what lets relative size carry the model. -->
                                        <Viewbox Width="56" Height="77" Stretch="Uniform"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Canvas Width="64" Height="88">
                                                <Path Data="{Binding OutlineBody}"
                                                      Stroke="{StaticResource Brush.Text}" StrokeThickness="2"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" Opacity="0.75" />

                                                <!-- Screen and home button: thinner and dimmer so they stay
                                                     detail inside the body rather than a second outline
                                                     competing with it. Both bind to null on edge-to-edge
                                                     models, which draws nothing. -->
                                                <Path Data="{Binding OutlineScreen}"
                                                      Stroke="{StaticResource Brush.Text}" StrokeThickness="1.5"
                                                      StrokeLineJoin="Round" Opacity="0.4" />
                                                <Path Data="{Binding OutlineHomeButton}"
                                                      Stroke="{StaticResource Brush.Text}" StrokeThickness="1.5"
                                                      Opacity="0.5" />

                                                <!-- Filled, not stroked: a hollow pill this small turns to
                                                     mush, and the same goes for the camera dot. -->
                                                <Path Data="{Binding OutlineIsland}"
                                                      Fill="{StaticResource Brush.Text}" Opacity="0.6" />
                                                <Path Data="{Binding OutlineCamera}"
                                                      Fill="{StaticResource Brush.Text}" Opacity="0.6" />
                                            </Canvas>
                                        </Viewbox>
                                        <!-- Connection state and transport, side by side in one row so the
                                             two badges cannot overlap as either label changes length between
                                             languages. -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <!-- Transport: which of the two is shown is driven by IsNetworkLink,
                                                 so a device unplugged while on Wi-Fi updates in place. -->
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.AccentSoft}"
                                                    Margin="0,0,6,0"
                                                    ToolTip="{DynamicResource L.Devices.Link.Wifi}"
                                                    Visibility="{Binding IsNetworkLink, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               Foreground="{StaticResource Brush.Accent}"
                                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock Text="{DynamicResource L.Devices.Link.Wifi}"
                                                               Foreground="{StaticResource Brush.Accent}" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.AccentSoft}"
                                                    Margin="0,0,6,0"
                                                    ToolTip="{DynamicResource L.Devices.Link.Usb}"
                                                    Visibility="{Binding IsNetworkLink, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE88E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               Foreground="{StaticResource Brush.Accent}"
                                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock Text="{DynamicResource L.Devices.Link.Usb}"
                                                               Foreground="{StaticResource Brush.Accent}" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.SuccessSoft}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Success}"
                                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{DynamicResource L.Devices.Connected}"
                                                               Foreground="{StaticResource Brush.Success}" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}"
                                               FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                                        <Run Text="{Binding Model, Mode=OneWay}" /> · iOS <Run Text="{Binding OsVersion, Mode=OneWay}" />
                                    </TextBlock>

                                    <!-- Battery -->
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource L.Devices.Battery}"
                                                   Style="{StaticResource Text.Caption}" Margin="0,0,10,0" />
                                        <ProgressBar Grid.Column="1" Style="{StaticResource Progress.Slim}"
                                                     Value="{Binding BatteryLevel, Mode=OneWay}" Maximum="100"
                                                     Foreground="{Binding BatteryLevel, Converter={StaticResource BatteryBrush}}"
                                                     VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Margin="10,0,0,0">
                                            <Run Text="{Binding BatteryLevel, Mode=OneWay}" />%
                                        </TextBlock>
                                    </Grid>

                                    <!-- Primary action -->
                                    <Button Content="{DynamicResource L.Devices.Select}"
                                            Style="{StaticResource Button.Primary}" Margin="0,16,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <!-- Secondary actions -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="{DynamicResource L.Devices.Info}"
                                                Style="{StaticResource Button.Secondary}"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.OpenDeviceInfoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="2" Content="{DynamicResource L.Devices.Photos}"
                                                Style="{StaticResource Button.Secondary}"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.OpenPhotosCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>

                                    <!-- Quick Transfer is deliberately a compact secondary action inside
                                         the device card: the destination device is never ambiguous. -->
                                    <Button Style="{StaticResource Button.Secondary}" Margin="0,8,0,0"
                                            HorizontalAlignment="Stretch"
                                            Click="OnQuickTransferClicked"
                                            Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="{DynamicResource L.QuickTransfer.Open}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- What is already installed here, as opposed to the catalog -->
                                    <Button Content="{DynamicResource L.OnDevice.Open}"
                                            Style="{StaticResource Button.Ghost}" Margin="0,8,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.OpenOnDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
