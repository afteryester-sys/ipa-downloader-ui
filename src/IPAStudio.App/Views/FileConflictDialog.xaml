<Window x:Class="IPAStudio.App.Views.FileConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Файл уже существует"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}">

    <StackPanel Margin="22">

        <TextBlock Text="Файл уже существует"
                   Style="{StaticResource Text.Body}"
                   FontSize="17" FontWeight="SemiBold" />

        <TextBlock x:Name="AppLine"
                   Style="{StaticResource Text.Body}"
                   TextWrapping="Wrap" Margin="0,10,0,0" />

        <!-- Details of the file that is already on disk. -->
        <Border CornerRadius="10" Padding="14"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                Margin="0,14,0,0">
            <StackPanel>
                <TextBlock x:Name="FileNameLine"
                           Style="{StaticResource Text.Body}"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="FileMetaLine"
                           Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <CheckBox x:Name="ApplyToAllBox"
                  Style="{StaticResource Check.Base}"
                  Content="Применить ко всем остальным файлам в этой очереди"
                  Margin="0,16,0,0" />

        <!-- Actions. Keeping both is the safe default and gets focus. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton"
                    Content="Пропустить"
                    Style="{StaticResource Button.Ghost}"
                    MinWidth="110" Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancel" />
            <Button x:Name="ReplaceButton"
                    Content="Заменить"
                    Style="{StaticResource Button.Secondary}"
                    MinWidth="110" Margin="0,0,8,0"
                    Click="OnReplace" />
            <Button x:Name="KeepBothButton"
                    Content="Сохранить оба"
                    Style="{StaticResource Button.Primary}"
                    MinWidth="140"
                    IsDefault="True"
                    Click="OnKeepBoth" />
        </StackPanel>
    </StackPanel>
</Window>
