<Window x:Class="IPAStudio.App.Views.DesktopToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="Height"
        Width="380"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Cursor="Hand"
        MouseLeftButtonDown="OnToastClicked"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave">

    <Grid Margin="16" SnapsToDevicePixels="True">
        <Border x:Name="ToastBorder"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.45" Color="#000000" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTranslate" Y="40" />
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon Circle -->
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                        x:Name="IconCircle"
                        Background="#2210B981" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="IconGlyph" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Message Stack -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleBlock" Text="Notification" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MessageBlock" Text="Details" FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0"
                               TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Dismiss Button -->
                <Button Grid.Column="2" Style="{StaticResource Button.Ghost}"
                        Width="28" Height="28" Margin="8,0,0,0" Padding="0"
                        VerticalAlignment="Top" Cursor="Hand"
                        Click="OnDismissClicked">
                    <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
