+}
+
+func (t *appstore) lookupLatestIOSExternalVersionID(acc Account, app App) (string, error) {
+	if app.ID == 0 {
+		return "", errors.New("app ID is required for platform version lookup")
+	}
+
+	countryCode, err := countryCodeFromStoreFront(acc.StoreFront)
+	if err != nil {
+		return "", fmt.Errorf("failed to resolve country code: %w", err)
+	}
+
+	params := url.Values{}
+	params.Add("version", "2")
+	params.Add("id", strconv.FormatInt(app.ID, 10))
+	params.Add("p", "mdm-lockup")
+	params.Add("caller", "MDM")
+	params.Add("platform", "enterprisestore")
+	params.Add("cc", strings.ToLower(countryCode))
+	params.Add("l", "en")
+
+	endpoint := fmt.Sprintf("https://uclient-api.itunes.apple.com/WebObjects/MZStorePlatform.woa/wa/lookup?%s", params.Encode())
+	request, err := t.downloadClient.NewRequest(gohttp.MethodGet, endpoint, nil)
+	if err != nil {
+		return "", fmt.Errorf("failed to create platform version lookup request: %w", err)
+	}
+
+	response, err := t.downloadClient.Do(request)
+	if err != nil {
+		return "", fmt.Errorf("platform version lookup request failed: %w", err)
+	}
+	defer response.Body.Close()
+
+	if response.StatusCode != gohttp.StatusOK {
+		return "", fmt.Errorf("platform version lookup returned HTTP %d", response.StatusCode)
+	}
+
+	var result platformVersionLookupResult
+	decoder := json.NewDecoder(response.Body)
+	decoder.UseNumber()
+	if err := decoder.Decode(&result); err != nil {
+		return "", fmt.Errorf("failed to decode platform version lookup response: %w", err)
+	}
+
+	item, ok := result.Results[strconv.FormatInt(app.ID, 10)]
+	if !ok || len(item.Offers) == 0 {
+		return "", errors.New("platform version lookup returned no app offers")
+	}
+
+	offer := item.Offers[0]
+	versionID := string(offer.Version.ExternalID)
+	if versionID == "" && offer.BuyParams != "" {
+		values, parseErr := url.ParseQuery(offer.BuyParams)
+		if parseErr != nil {
+			return "", fmt.Errorf("failed to parse platform buy parameters: %w", parseErr)
+		}
+		versionID = values.Get("appExtVrsId")
+	}
+	if versionID == "" {
+		return "", errors.New("platform version lookup returned no external version id")
+	}
+
+	return versionID, nil
+}
